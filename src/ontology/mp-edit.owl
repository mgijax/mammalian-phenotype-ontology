# Class: <http://purl.obolibrary.org/obo/MP_0013562> (abnormal circumventricular organ morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0005408") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Circumventricular_organs") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013562> "any structural abnormality of any of the secretory or sensory organs located in the brain region around or in relation to the ventricular system that are characterized by extensive vasculature and a lack of a normal blood brain barrier (BBB) and allow for the linkage between the central nervous system and peripheral blood flow; CVOs contain neural tissue and are an integral part of neuroendocrine function; all of the CVOs, besides the subcommissural organ, contain extensive vasculature and fenestrated capillaries which leads to a leaky BBB at the site of the organs; the lack of a BBB allows CVOs to act as an alternative route for peptides and hormones in the neural tissue to the peripheral blood stream, while still protecting it from toxic substances")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013562> "abnormal CVO morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013562> "abnormal circumventricular organ of neuraxis morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013562> "MP:0013562")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013562> "abnormal circumventricular organ morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013562> <http://purl.obolibrary.org/obo/MP_0002152>)


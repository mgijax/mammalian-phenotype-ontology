AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030556> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030556> "MP:0030556")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030556> "abnormal cementocyte canaliculus morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030556> <http://purl.obolibrary.org/obo/MP_0030549>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030556> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001753>)))

# Class: <http://purl.obolibrary.org/obo/MP_0030557> (abnormal cementocyte dendritic process morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27029548") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=8131238016") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030557> "any structural anomaly of the long, slender cytoplasmic processes that extend from the cementocyte cell body, run along narrow canaliculi, and are linked to neighboring cementocytes processes via gap junctions; cementocytes harbor fewer dendritic processes than osteocytes")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030557> <https://orcid.org/0000-0002-6490-7723>)

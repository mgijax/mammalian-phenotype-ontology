AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031730> "MP:0031730")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031730> "atrial premature beat")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031730> <http://purl.obolibrary.org/obo/MP_0031728>)

# Class: <http://purl.obolibrary.org/obo/MP_0031731> (abnormal ST segment)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/st-segment-ecg-library/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459364/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031731> "any anomaly in the ECG section between the end of the S wave (the J point) and the beginning of the T wave; it represents an electrically neutral area of the complex between ventricular depolarization (QRS complex) and repolarization (T wave)")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031731> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4260>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031731> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031731> "2026-05-04T17:36:28Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031731> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031731> "MP:0031731")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031731> "The ST segment is normally flat and at the same level (isoelectric) as the PR and TP segments. It corresponds to the plateau phase (phase 2) of the cardiac action potential during which the ventricular myocardium is refractory to further stimulation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031731> "abnormal ST segment")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031731> <http://purl.obolibrary.org/obo/MP_0010508>)

# Class: <http://purl.obolibrary.org/obo/MP_0031732> (ST segment elevation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0012251") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://aclscertification.org/what-is-ecg-st-segment-elevation/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ecgwaves.com/st-segment-normal-abnormal-depression-elevation-causes/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459364/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031732> "an upward deviation of the ST segment on an ECG, where the J-point is displaced above the isoelectric baseline")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031732> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4260>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031732> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031732> "2026-05-04T17:51:39Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031732> "elevated ST segment")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031732> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031732> "MP:0031732")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031732> "ST elevation can signal urgent, transmural myocardial ischemia (STEMI). While associated with acute heart attacks, it can also be caused by benign conditions (early repolarization), pericarditis, or ventricular aneurysms.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031732> "ST segment elevation")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031732> <http://purl.obolibrary.org/obo/MP_0031731>)

# Class: <http://purl.obolibrary.org/obo/MP_0031733> (ST segment depression)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0012250") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ecgwaves.com/st-segment-normal-abnormal-depression-elevation-causes/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459364/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031733> "a downward deviation of the ST segment on an ECG, where the J-point is displaced below the isoelectric baseline")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031733> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4260>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031733> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031733> "2026-05-04T18:16:32Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031733> "depressed ST segment")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031733> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031733> "MP:0031733")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031733> "ST segment depression often signifies subendocardial ischemia, especially when horizontal or downsloping. Common causes include myocardial infarction, left ventricular hypertrophy (strain), medications (e.g. digitalis), and hypokalemia.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031733> "ST segment depression")

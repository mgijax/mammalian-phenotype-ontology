# Class: <http://purl.obolibrary.org/obo/MP_0030510> (abnormal tooth placode morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0060790") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26755699") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK27071/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030510> "any structural anomaly of the local thickening that is formed within the primary dental lamina and grows into a solid epithelial tooth bud that invades the underlying mesenchyme; the placodes consist of thickened epithelium and underlying neural crest derived mesenchyme, and they function as the first signaling centers of the tooth")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030510> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030510> "2017-12-22T12:12:26Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030510> "abnormal dental anlage morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030510> "abnormal dental placode morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030510> "abnormal dental primordium morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030510> "abnormal odontogenic placode morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030510> "abnormal tooth anlage morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030510> "abnormal tooth primordium morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030510> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030510> "MP:0030510")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24487243") rdfs:comment <http://purl.obolibrary.org/obo/MP_0030510> "The term placode has not been universally adopted in the field of tooth development research; in mouse, stages prior to bud (E11–E12.5) have often been collectively referred to as the epithelial thickening, dental lamina, or simply initiation stage")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030510> "abnormal tooth placode morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030510> <http://purl.obolibrary.org/obo/MP_0000116>)

# Class: <http://purl.obolibrary.org/obo/MP_0030511> (abnormal dentinoenamel junction morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=1118938313") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Dentinoenamel_junction") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030511> "any structural anomaly of the interface that joins two distinct calcified tissues, enamel and dentin; it presents a scalloped contour, with its concave side toward the enamel and the convex side toward the dentin, thought to increase adherence of the enamel to the dentin, especially in areas of occlusal stress; DEJ plays a key role in resisting crack propagation from enamel to dentin")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030511> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030511> "2017-12-22T12:50:08Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030511> "abnormal DEJ morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030511> "abnormal amelo-dentinal junction morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030511> "abnormal amelodentinal junction morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030511> "abnormal dentin-enamel junction morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030511> "abnormal dentino-enamel junction morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030511> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030511> "MP:0030511")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030511> "abnormal dentinoenamel junction morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030511> <http://purl.obolibrary.org/obo/MP_0003930>)

# Class: <http://purl.obolibrary.org/obo/MP_0030512> (abnormal Tomes' process morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20016979") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=0199533016") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030512> "any structural anomaly of the pyramidal extension at the apical pole of a secretory ameloblast that plays an important role in organizing the enamel crystals into a complex network of rod (prism) and interrod enamel; Tomes' processes interdigitate with the surface of the forming enamel giving it a picket fence appearance and determine the orientation of the newly formed (nucleated) enamel hydroxyapatite crystals; as the secretory stage ends, Tomes' processes are lost and accordingly the last formed layers of enamel are rodless or prismless")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030512> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030512> "2017-12-22T13:05:56Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030512> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030512> "MP:0030512")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030512> "abnormal Tomes' process morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030512> <http://purl.obolibrary.org/obo/MP_0002650>)

# Class: <http://purl.obolibrary.org/obo/MP_0030513> (short Tomes' process)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030214> "MP:0030214")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030214> "muscle fasciculation")

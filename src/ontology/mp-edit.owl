AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0004754> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0004754> "MP:0004754")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004754> "abnormal kidney collecting duct morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0004754> <http://purl.obolibrary.org/obo/MP_0002135>)

# Class: <http://purl.obolibrary.org/obo/MP_0004755> (abnormal loop of Henle morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-3691-0324>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0004755> "any structural anomaly of the section of the renal tubule in the kidney medulla with a hairpin bend; consists of a descending limb and an ascending limb, and is situated between the proximal convoluted tubule to the distal convoluted tubule; it functions to reabsorb water and ions from the urine")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0004755> "MA:0001675")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0004755> "abnormal ansa nephroni morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0004755> "abnormal limb of Henle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0004755> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0004755> "abnormal Henle's loop morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0004755> "abnormal nephron loop morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0004755> "MP:0004755")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004755> "abnormal loop of Henle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0004755> <http://purl.obolibrary.org/obo/MP_0002703>)

# Class: <http://purl.obolibrary.org/obo/MP_0004756> (abnormal proximal convoluted tubule morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-3691-0324>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0004756> "any structural anomaly of the convoluted portion of the duct system of the nephron that extends from the renal glomerular capsule in the kidney cortex into the kidney medulla where it joins the loop of Henle; fluid entering the proximal convoluted tubule is reabsorbed into the peritubular capillaries, including approximately two-thirds of the filtered salt and water and all filtered organic solutes; the most distinctive characteristic of the proximal tubule is its brush border (or striated border), not found in the distal convoluted tubule")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0004756> "abnormal proximal kidney tubule")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0004756> "abnormal proximal renal tubule")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0004756> "abnormal proximal tubule")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0004756> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0004756> "MP:0004756")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004756> "abnormal proximal convoluted tubule morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0004756> <http://purl.obolibrary.org/obo/MP_0002703>)

# Class: <http://purl.obolibrary.org/obo/MP_0004757> (abnormal distal convoluted tubule morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-3691-0324>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0004757> "any structural anomaly of the convoluted portion of the duct system of the nephron between the ascending portion of the loop of Henle and the collecting duct system in the kidney cortex; it is partly responsible for the regulation of potassium, sodium, calcium, and pH through the endocrine system")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0004757> "MPheno.ontology")

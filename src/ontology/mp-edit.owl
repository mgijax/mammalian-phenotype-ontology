AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0012669> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0012669> "MP:0012669")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012669> "abnormal somite segmentation clock")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012669> <http://purl.obolibrary.org/obo/MP_0001688>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031423> "abnormal corpus luteum regression")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031423> "abnormal luteal regression")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031423> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031423> "MP:0031423")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24586455") rdfs:comment <http://purl.obolibrary.org/obo/MP_0031423> "The regression of the corpus luteum is essential to reset the ovarian cycle, so that mammals obtain another chance to become pregnant.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031423> "abnormal luteolysis")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031423> <http://purl.obolibrary.org/obo/MP_0009344>)


# Class: <http://purl.obolibrary.org/obo/MP_0031629> (abnormal mounting behavior)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780128132524") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://ndl.ethernet.edu.et/bitstream/123456789/718/1/66.pdf.pdf") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031629> "any anomaly in the behavior during which a male typically climbs onto a female adopting a position that facilitates copulation; in mammals, mounting usually consists of a male's standing on his hindlegs and grasping a female's flanks from behind")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031629> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031629> "2024-06-05T10:58:06Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031629> "abnormal mounting behaviour")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031629> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031629> "MP:0031629")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37324524") rdfs:comment <http://purl.obolibrary.org/obo/MP_0031629> "In rodents, the male assumes a copulatory position that is dorsally and from the rear. Mounting is mostly associated with thrusting motions of the hindquarters (pelvic thrusts). During mounting, the male lifts his forebody over the female hindquarters, clasping her flanks with its forepaws while keeping its hindlegs on the floor, and begins a series of rapid shallow movements of the pelvis without achieving penetration. Mounting may or may not result in intromission.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031629> "abnormal mounting behavior")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031629> <http://purl.obolibrary.org/obo/MP_0009697>)


# Class: <http://purl.obolibrary.org/obo/MP_0030783> (abnormal posterior longitudinal ligament morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.kenhub.com/en/library/anatomy/joints-and-ligaments-of-the-vertebral-column") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030783> "any structural anomaly of the ligament that runs within the vertebral canal along the posterior aspect of the vertebral bodies; it is attached mainly to the intervertebral (IV) discs and less so to the posterior aspects of the vertebral bodies from C2 (axis) to the sacrum, often bridging fat and vessels between the ligament and the bony surface; it weakly resists hyperflexion of the vertebral column and helps prevent or redirect posterior herniation of the nucleus pulposus of an IV disc; the posterior longitudinal ligament is well provided with nociceptive (pain) nerve endings and is a much narrower, somewhat weaker band than the anterior longitudinal ligament")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030783> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030783> "2018-09-20T08:03:33Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030783> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030783> "MP:0030783")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030783> "abnormal posterior longitudinal ligament morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030783> <http://purl.obolibrary.org/obo/MP_0004703>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030783> <http://purl.obolibrary.org/obo/MP_0005504>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030783> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001130>)))

# Class: <http://purl.obolibrary.org/obo/MP_0030784> (abnormal iliofemoral ligament morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.anatomyexpert.com/app/structure/15412/702/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://medical-dictionary.thefreedictionary.com/iliofemoral+ligament") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030784> "any structural anomaly of the strong triangular ligament that is attached by its apex to the anterior inferior spine of the ilium and acetabular margin and by its base to the intertrochanteric line of the femur; it stabilizes the hip joint and limits extension and lateral rotation of the hip")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030784> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030784> "2018-09-20T08:19:58Z"^^xsd:dateTime)

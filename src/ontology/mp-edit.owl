AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030502> "abnormal incisive foramen morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030502> <http://purl.obolibrary.org/obo/MP_0030310>)


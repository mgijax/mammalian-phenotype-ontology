# Class: <http://purl.obolibrary.org/obo/MP_0013543> (abnormal holocrine gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Holocrine") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://medical-dictionary.thefreedictionary.com/holocrine+gland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013543> "any structural anomaly of any exocrine gland whose secretion consists of its own disintegrated secretory cells along with its secretory product; holocrine secretions are produced in the cytoplasm of the cell and released by the rupture of the plasma membrane, which destroys the cell and results in the secretion of the product into the lumen")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013543> "MP:0013543")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013543> "abnormal holocrine gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013543> <http://purl.obolibrary.org/obo/MP_0013558>)

# Class: <http://purl.obolibrary.org/obo/MP_0013544> (abnormal merocrine gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Merocrine") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013544> "any structural anomaly of any exocrine gland whose secretions are excreted via exocytosis from secretory cells into an epithelial-walled duct or ducts and thence onto a bodily surface or into the lumen; the gland releases its product and no part of the gland is lost or damaged")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013544> "abnormal eccrine gland morphology")

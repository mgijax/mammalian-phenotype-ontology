# Class: <http://purl.obolibrary.org/obo/MP_0031237> (diffuse alveolar damage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0033006") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28570160") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031237> "a common histological injury pattern of the lung, whereby the early stages are characterized by epithelial cell necrosis and sloughing, fibrous exudate, edema, and hyaline membranes made of surfactant and proteins, filling the alveoli and resulting in impaired gas exchange; in later stages, alveolar type II cells and myofibroblasts proliferate within the interstitium and airspaces; the corresponding clinical entity is ARDS (acute respiratory distress syndrome)")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031237> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031237> "2021-03-08T10:36:03Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031237> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031237> "MP:0031237")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031237> "diffuse alveolar damage")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031237> <http://purl.obolibrary.org/obo/MP_0010899>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031237> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0006524>)))

# Class: <http://purl.obolibrary.org/obo/MP_0031238> (reactive type II pneumocyte hyperplasia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11079017") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031238> "alteration to type II pneumocytes following lung injury that results in increased numbers of these cells occurring in clusters and having morphological alterations including: cuboidal shapes, increased nucleocytoplasmic ratio, enlarged nuclei, prominent nucleoli, and various alterations in their nuclear chromatin")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031238> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031238> "2021-03-08T12:21:37Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031238> "reactive alveolar type II cell hyperplasia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031238> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031238> "MP:0031238")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031238> "reactive type II pneumocyte hyperplasia develops as a response to alveolar injury in various pulmonary disorders, esp. in the setting of inflammation and interstitial fibrosis and during the healing phase of diffuse alveolar damage")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031238> "reactive type II pneumocyte hyperplasia")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031238> <http://purl.obolibrary.org/obo/MP_0010810>)


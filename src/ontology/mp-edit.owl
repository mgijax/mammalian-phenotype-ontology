# Class: <http://purl.obolibrary.org/obo/MP_0030785> (abnormal falciform ligament morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0001247") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Falciform_ligament") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://radiopaedia.org/articles/falciform-ligament") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030785> "any structural anomaly of the broad and thin, sickle-shaped peritoneal ligament that attaches the liver to the anterior body wall and is a remnant of the ventral mesentery of the fetus; it is situated in an anteroposterior plane but lies obliquely so that one surface faces forward and is in contact with the peritoneum behind the right rectus abdominis and the diaphragm, while the other is directed backwards and is in contact with the left lobe of the liver")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030785> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030785> "2018-09-20T08:46:40Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030785> "abnormal ligamentum falciforme hepatis morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030785> "abnormal liver falciform ligament morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030785> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030785> "MP:0030785")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030785> "abnormal falciform ligament morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030785> <http://purl.obolibrary.org/obo/MP_0000598>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030785> <http://purl.obolibrary.org/obo/MP_0005504>)

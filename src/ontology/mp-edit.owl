AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030853> "MP:0030853")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030853> "abnormal iliac crest morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030853> <http://purl.obolibrary.org/obo/MP_0005354>)


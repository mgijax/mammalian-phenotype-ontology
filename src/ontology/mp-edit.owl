# Class: <http://purl.obolibrary.org/obo/MP_0013282> (urinary bladder exstrophy)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17079275") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://medical-dictionary.thefreedictionary.com/exstrophy+of+the+bladder") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013282> "a herniation of the urinary bladder through an anterior abdominal wall defect; refers to congenital absence of a portion of the lower anterior abdominal wall and the anterior urinary bladder wall, with eversion of the posterior bladder wall through the defect, an open pubic arch, and widely separated ischia connected by a fibrous band")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013282> "ectopia vesicae")

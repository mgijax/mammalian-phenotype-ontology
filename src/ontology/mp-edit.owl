# Class: <http://purl.obolibrary.org/obo/MP_0014175> (abnormal ciliary epithelium morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://cdn.intechopen.com/pdfs-wm/41830.pdf") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0014175> "any structural anomaly of the double layer lining the inner surfaces of the ciliary processes and the pars plana (i.e. the posterior portion of the ciliary body, aka orbicularis ciliari); the outer layer is the pigmented epithelium, which is composed of low cuboidal cells and is adjacent to the stroma and continuous with the retinal pigmented epithelium; the inner layer is formed by non-pigmented epithelium, a columnar epithelium, adjacent to the aqueous humor in the posterior chamber and continuous with the retina; these two layers of the epithelium are appositioned in their apical surfaces")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014175> "abnormal ciliary body epithelium morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014175> "abnormal epithelium of ciliary body morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014175> "abnormal ocular ciliary epithelium morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0014175> "MP:0014175")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0014175> "abnormal ciliary epithelium morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0014175> <http://purl.obolibrary.org/obo/MP_0005099>)

# Class: <http://purl.obolibrary.org/obo/MP_0014176> (abnormal cilary zonule morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23493297") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24908666") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0014176> "any structural anomaly of the circumferential suspensory ligaments that anchor the lens to the ciliary process and are made of bundles of fibrillin microfibrils, an elaborate system of fibers that spans the gap between the lens and the adjacent nonpigmented ciliary epithelium; this fibrous rigging ensures lens centration; in species that accommodate, the zonule transmits the forces that flatten the lens, allowing the eye to focus on distant objects")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014176> "abnormal Zinn zonule morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014176> "abnormal Zinn's zonule morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014176> "abnormal apparatus suspensorius lentis morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014176> "abnormal suspensory ligament of lens morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014176> "abnormal zonula ciliaris morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0014176> "MP:0014176")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0014176> "abnormal cilary zonule morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0014176> <http://purl.obolibrary.org/obo/MP_0005193>)

# Class: <http://purl.obolibrary.org/obo/MP_0014177> (abnormal Weber's gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19166479") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0014177> "any structural anomaly of the lingual glands located on the lateral margins of the tongue, at the level of the foliate papillae and in the root of the tongue behind the circumvallate papillae; in humans, the ducts of posterior superficial lingual glands open into the crypts of lingual tonsils; mucous supplied by these glands may help to cleanse the crypts and aid in deglutition")

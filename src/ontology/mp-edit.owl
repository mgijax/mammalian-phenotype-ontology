AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030877> "abnormal symphysis morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030877> <http://purl.obolibrary.org/obo/MP_0030875>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030877> <http://purl.obolibrary.org/obo/MP_0030878>)

# Class: <http://purl.obolibrary.org/obo/MP_0030878> (abnormal fibrous joint morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Fibrous_joint") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.visiblebody.com/learn/skeleton/joints-and-ligaments") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030878> "any structural anomaly of any joint that lacks a joint cavity and involves bones that are joined together by dense fibrous connective tissue, consisting mainly of collagen; most (but not all) fibrous joints are immovable (synarthroses)")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030878> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030878> "2018-10-17T12:49:17Z"^^xsd:dateTime)

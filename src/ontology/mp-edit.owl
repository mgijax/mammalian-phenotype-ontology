AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031754> "decrease in the length of time of the P wave electrical impulses, measured from the beginning to the end of the P wave")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031754> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4289>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031754> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031754> "2026-07-14T11:39:55Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031754> "decreased P wave width")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031754> "reduced P wave width")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031754> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031754> "MP:0031754")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031754> "shortened P wave")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031754> <http://purl.obolibrary.org/obo/MP_0004070>)

# Class: <http://purl.obolibrary.org/obo/MP_0031755> (notched P wave)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0031598") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Notching_in_electrocardiography") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.droracle.ai/articles/664386/what-does-a-bifid-p-wave-in-chest-leads") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031755> "a double-peaked or M-shaped P wave, commonly indicating left atrial abnormality")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031755> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4289>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031755> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031755> "2026-07-14T11:45:21Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031755> "bifid P wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031755> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0031755> "split P wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031755> "MP:0031755")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031755> "Notched P waves often reflect delayed atrial conduction or left atrial enlargement.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031755> "notched P wave")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031755> <http://purl.obolibrary.org/obo/MP_0004070>)

# Class: <http://purl.obolibrary.org/obo/MP_0031756> (first degree atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0011705") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ecgwaves.com/topic/ecg-first-degree-av-block-i-1-criteria-management/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459147/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031756> "a delay in the propagation of electrical impulses from the atria to the ventricles characterized by a prolonged PR interval without any dropped beats; every P wave is followed by a QRS complex, i.e., all atrial impulses reach the ventricles")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031756> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4310>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031756> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031756> "2026-07-20T09:13:22Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031756> "1st-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031756> "AV block 1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031756> "AV block I")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031756> "first-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031756> "first-degree atrioventricular block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031756> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031756> "MP:0031756")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031756> "First-degree AV block is more accurately defined as an AV delay because no P waves are blocked. The delay is typically due to a minor AV conduction defect occurring at or below the AV node. In a \"marked\" first-degree AV block, the PR interval is excessively prolonged and the P waves may be buried in the preceding T wave.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031756> "first degree atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031756> <http://purl.obolibrary.org/obo/MP_0010519>)

# Class: <http://purl.obolibrary.org/obo/MP_0031757> (second degree atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0011706") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459147/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK482359/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031757> "an intermittent atrioventricular (AV) block with failure of some atrial impulses to conduct to the ventricles, leading to skipped beats; some but not all atrial impulses are conducted through the AV node and trigger ventricular contraction")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031757> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4317>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031757> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031757> "2026-07-20T12:45:16Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031757> "2nd-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031757> "second-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031757> "second-degree atrioventricular block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031757> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031757> "MP:0031757")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031757> "Second-degree AV blocks can be further classified into Mobitz type 1 (Wenckebach) or Mobitz type 2, which can be distinguished by examining the PR interval.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031757> "second degree atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031757> <http://purl.obolibrary.org/obo/MP_0010519>)

# Class: <http://purl.obolibrary.org/obo/MP_0031758> (2:1 atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0034305") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/av-block-2nd-degree-fixed-ratio-blocks/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459147/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031758> "a type of second-degree atrioventricular (AV) block in which every other P wave is not conducted through the AV node such that only every other P wave is followed by a QRS complex")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031758> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4317>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031758> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031758> "2026-07-20T12:51:18Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031758> "2:1 AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031758> "second-degree 2:1 AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031758> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031758> "MP:0031758")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031758> "When every other P wave is blocked (not conducted), it is impossible to differentiate between Mobitz type I (Wenckebach) and Mobitz type II AV block, so this entity is called a 2:1 AV block.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031758> "2:1 atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031758> <http://purl.obolibrary.org/obo/MP_0031757>)

# Class: <http://purl.obolibrary.org/obo/MP_0031759> (high degree atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/av-block-2nd-degree-high-grade-av-block/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459147/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031759> "an advanced form of second-degree atrioventricular (AV) block characterized by the presence of 2 or more consecutive, non-conducted P waves occurring at a constant physiologic rate, along with evidence of AV conduction; the P-to-QRS ratio is 3:1 or greater, producing an extremely slow ventricular rate")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031759> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4317>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031759> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031759> "2026-07-20T13:00:23Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031759> "2nd degree, high-grade AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031759> "high-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031759> "high-degree atrioventricular block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031759> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031759> "MP:0031759")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031759> "High-grade AV block may result from either Mobitz I or Mobitz II AV block. High-grade AV block and Mobitz II are considered pathological and frequently progress to a complete (third-degree) heart block.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031759> "high degree atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031759> <http://purl.obolibrary.org/obo/MP_0031757>)

# Class: <http://purl.obolibrary.org/obo/MP_0031760> (Mobitz I atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0011707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459147/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK482359/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031760> "a type of second-degree atrioventricular block characterized by P waves exhibiting a consistent rate and a gradual prolongation of the PR interval; this is followed by periodic occurrences of single non-conducted P waves, typically accompanied by P waves preceding and following the non-conducted P waves")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031760> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4317>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031760> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031760> "2026-07-20T13:04:51Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031760> "2nd-degree, Mobitz I AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031760> "Mobitz I AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031760> "Mobitz type 1 atrioventricular block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031760> "Mobitz type I second-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031760> "Wenckebach block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031760> "Wenckebach phenomenon")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031760> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031760> "MP:0031760")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031760> "Mobitz I is usually due to reversible conduction block at the level of the AV node. It is usually a benign rhythm, causing minimal hemodynamic disturbance and with low risk of progression to third-degree heart block.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031760> "Mobitz I atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031760> <http://purl.obolibrary.org/obo/MP_0031757>)

# Class: <http://purl.obolibrary.org/obo/MP_0031761> (Mobitz II atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0011708") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459147/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK482359/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031761> "a more severe type of second-degree atrioventricular block characterized by P waves occurring at a constant rate and periodic single non-conducted P waves that arise at unpredictable intervals; these non-conducted P waves are typically observed alongside other P waves, both before and after the non-conducted P wave, and exhibit consistent PR intervals")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031761> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4317>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031761> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031761> "2026-07-20T13:17:03Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031761> "2nd-degree, Mobitz II AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031761> "Hay block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031761> "Mobitz II AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031761> "Mobitz type 2 atrioventricular block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031761> "Mobitz type II second-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031761> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031761> "MP:0031761")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031761> "Unlike Mobitz I (which usually occurs in the AV node and is often benign), Mobitz II is typically caused by structural damage in the His-Purkinje system below the AV node and often progresses to complete (third-degree) AV block.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031761> "Mobitz II atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031761> <http://purl.obolibrary.org/obo/MP_0031757>)

# Class: <http://purl.obolibrary.org/obo/MP_0031762> (third degree atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0001709") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/av-block-3rd-degree-complete-heart-block/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459147/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031762> "a life-threatening atrioventricular (AV) block characterized by complete AV dissociation, with no supraventricular impulses conducted to the ventricles; ECG demonstrates more P waves than QRS complexes, a highly variable PR interval, and independent atrial and ventricular rates")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031762> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4318>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031762> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031762> "2026-07-20T14:30:31Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031762> "3rd-degree AV block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031762> "complete heart block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031762> "third-degree atrioventricular block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031762> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0031762> "third-degree heart block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031762> "MP:0031762")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031762> "In third-degree AV block, there is no relationship between P waves and QRS complexes. The P waves are said to “march through” the QRS complexes at their regular, faster rate. The QRS complexes also occur at a regular but slower rate. Two independent rhythms occur simultaneously. Ventricular activity is maintained by a subsidiary pacemaker, either a junctional escape rhythm (narrow QRS complex) or a ventricular escape rhythm (wide QRS complex).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031762> "third degree atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031762> <http://purl.obolibrary.org/obo/MP_0010519>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0012538> "hyaloid artery remnant")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0012538> "persistence of hyaloid artery")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0012538> "persistent arteria hyaloidea")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0012538> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0012538> "MP:0012538")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012538> "persistent hyaloid artery")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012538> <http://purl.obolibrary.org/obo/MP_0012537>)


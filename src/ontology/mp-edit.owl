# Class: <http://purl.obolibrary.org/obo/MP_0030788> (abnormal femur head morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0006767") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Femoral_head") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Femur") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030788> "any structural anomaly of the highest, globular part of the thigh bone which comprises two-thirds of a sphere and articulates with the acetabulum in the pelvic bone forming the hip joint; the head is attached to the femoral body or shaft by the neck of the femur; its surface is smooth, coated with cartilage in the fresh state, except over an ovoid depression, the fovea capitis femoris, which is situated a little below and behind the center of the head, and gives attachment to the ligament of head of femur")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030788> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030788> "2018-09-20T10:00:23Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030788> "abnormal femoral head morphology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0003368") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030788> "abnormal head of thigh bone")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030788> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030788> "MP:0030788")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030788> "abnormal femur head morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030788> <http://purl.obolibrary.org/obo/MP_0000559>)


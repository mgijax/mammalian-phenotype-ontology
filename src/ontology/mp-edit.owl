# Class: <http://purl.obolibrary.org/obo/MP_0030156> (abnormal tympanic cavity muscle morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030156> "any structural anomaly of either of the two tiny striated muscles (tensor tympani and stapedius) located within the tympanic cavity; these muscles contract in response to loud noise, inhibiting the vibrations of the malleus, incus and stapes, and reducing the transmission of sound to the inner ear")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030156> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030156> "2017-09-21T09:36:12Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030156> "http://emedicine.medscape.com/article/874456-overview#a6")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030156> "http://teachmeanatomy.info/head/organs/ear/middle-ear/")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030156> "abnormal auditory ossicle muscle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030156> "abnormal intratympanic muscle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030156> "abnormal middle ear muscle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030156> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030156> "MP:0030156")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030156> "abnormal tympanic cavity muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030156> <http://purl.obolibrary.org/obo/MP_0000759>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030156> <http://purl.obolibrary.org/obo/MP_0030154>)

# Class: <http://purl.obolibrary.org/obo/MP_0030157> (abnormal stapedius muscle morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030157> "any structural anomaly of the tiny striated muscle found in the pyramidal eminence on the posterior wall of the tympanic cavity, whose tendon inserts onto the neck of the stapes; like the tensor tympani, it helps to dampen loud sounds; it is innervated by a small branch from the facial nerve")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030157> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030157> "2017-09-21T10:04:47Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030157> "http://www.dummies.com/education/science/anatomy/the-anatomy-of-the-middle-ear/")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030157> "abnormal stapedius morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030157> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030157> "MP:0030157")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030157> "abnormal stapedius muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030157> <http://purl.obolibrary.org/obo/MP_0030039>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030157> <http://purl.obolibrary.org/obo/MP_0030156>)

# Class: <http://purl.obolibrary.org/obo/MP_0030158> (absent stapedius muscle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030158> "missing the tiny muscle normally found in the pyramidal eminence on the posterior wall of the tympanic cavity, whose tendon inserts onto the neck of the stapes")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030307> "abnormal fossa cranii anterior morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030307> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030307> "MP:0030307")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030307> "abnormal anterior cranial fossa")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030307> <http://purl.obolibrary.org/obo/MP_0030306>)

# Class: <http://purl.obolibrary.org/obo/MP_0030308> (abnormal middle cranial fossa morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://teachmeanatomy.info/head/areas/cranial-fossa/middle/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Middle_cranial_fossa") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://radiopaedia.org/articles/middle-cranial-fossa") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030308> "any structural anomaly of the butterfly-shaped depression which is centrally located in the cranial floor, narrow in the middle and wider laterally, and houses the temporal lobes of the cerebrum and the pituitary gland; it is separated from the posterior fossa by the clivus and the petrous crest; it is bounded: in front, by the posterior margins of the lesser wings of the sphenoid bone, the anterior clinoid processes, and the ridge forming the anterior margin of the chiasmatic groove; behind, by the superior angles of the petrous portions of the temporal bones and the dorsum sellae; laterally, by the temporal squamae, sphenoidal angles of the parietals, and greater wings of the sphenoid; it is traversed by the squamosal, sphenoparietal, sphenosquamosal, and sphenopetrosal sutures")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030308> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030308> "2017-10-23T10:01:28Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/MP_0030308> "abnormal middle fossa morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030308> "abnormal fossa cranii media morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030308> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030308> "MP:0030308")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030308> "abnormal middle cranial fossa morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030308> <http://purl.obolibrary.org/obo/MP_0030306>)

# Class: <http://purl.obolibrary.org/obo/MP_0030309> (abnormal posterior cranial fossa morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://teachmeanatomy.info/head/areas/cranial-fossa/posterior/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://radiopaedia.org/articles/posterior-cranial-fossa") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030309> "any structural anomaly of the most inferior and deepest of the cranial fossae, located between the foramen magnum and tentorium cerebelli, which houses the brainstem and cerebellum; it is bounded anteriorly and medially by the dorsum sellae of the sphenoid bone; anteriorly and laterally by the superior border of the petrous part of the temporal bone; and posteriorly by the internal surface of the squamous part of the occipital bone; its floor consists of the mastoid part of the temporal bone and the squamous, condylar and basilar parts of the occipital bone")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030309> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030309> "2017-10-23T10:11:35Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/MP_0030309> "abnormal posterior fossa morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030309> "abnormal fossa cranii posterior morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030309> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030309> "MP:0030309")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030309> "abnormal posterior cranial fossa morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030309> <http://purl.obolibrary.org/obo/MP_0030306>)


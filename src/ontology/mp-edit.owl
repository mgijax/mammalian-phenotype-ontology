# Class: <http://purl.obolibrary.org/obo/MP_0001163> (abnormal prostate gland anterior lobe morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12645922") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:3308446") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0001163> "any structural anomaly of the rodent prostate lobe that appears as a thin tubular structure, attached to the lesser curvature of the paired seminal vesicles")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/MP_0001163> "MP:0000663")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0001163> "MA:0002422")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0001163> "abnormal AP morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0001163> "abnormal CG morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0001163> "abnormal anterior prostate morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0001163> "abnormal coagulating gland morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0001163> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0001163> "MP:0001163")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0001163> "In rodents, the prostate gland consists of three lobes, the anterior prostate (AP; also known as the coagulating gland), the dorsolateral prostate (DLP), and the ventral prostate (VP). These lobes are arranged circumferentially around the urethra and display characteristic patterns of ductal branching and protein secretion (PMID:3308446). In contrast, the adult human prostate lacks discernible lobular organization and, instead, completely envelops the urethra at the base of the bladder (PMID:3308446).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0001163> "abnormal prostate gland anterior lobe morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0001163> <http://purl.obolibrary.org/obo/MP_0001158>)


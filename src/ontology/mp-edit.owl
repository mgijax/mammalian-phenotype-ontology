# Class: <http://purl.obolibrary.org/obo/MP_0030208> (abnormal intrinsic tongue muscle morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tongue") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.imaios.com/en/e-Anatomy/Anatomical-Parts/Muscles-of-tongue") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030208> "any structural anomaly of any of the four paired muscles that originate and insert within the tongue, running along its length; these muscles alter the shape of the tongue by lengthening and shortening it, curling and uncurling its apex and edges, and flattening and rounding its surface; they include the superior longitudinal muscle, the inferior longitudinal muscle, the vertical muscle, and the transverse muscle")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030208> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030208> "2017-09-28T07:38:50Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030208> "abnormal intrinsic lingual muscle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030208> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030208> "MP:0030208")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030208> "abnormal intrinsic tongue muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030208> <http://purl.obolibrary.org/obo/MP_0004136>)

# Class: <http://purl.obolibrary.org/obo/MP_0030209> (abnormal extrinsic tongue muscle morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tongue") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.imaios.com/en/e-Anatomy/Anatomical-Parts/Muscles-of-tongue") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030209> "any structural anomaly of any of the four paired muscles that originate outside of and insert into the tongue and act to alter the position of the tongue, allowing for protrusion, retraction, and side-to-side movement; these muscles include the genioglossus, the hyoglossus (often including the chondroglossus), the styloglossus, and the palatoglossus")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030209> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030209> "2017-09-28T08:10:03Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030209> "abnormal extrinsic lingual muscle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030209> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030209> "MP:0030209")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030209> "abnormal extrinsic tongue muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030209> <http://purl.obolibrary.org/obo/MP_0004136>)

# Class: <http://purl.obolibrary.org/obo/MP_0030210> (abnormal genioglossus muscle morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Genioglossus") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030210> "any structural anomaly of the paired, fan-shaped extrinsic tongue muscle which forms the majority of the body of the tongue, arises from the mental spine of the mandible and inserts into the hyoid bone and the bottom of the tongue; its action protracts and depresses the tongue")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030210> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030210> "2017-09-28T09:37:50Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030210> "abnormal genioglossal muscle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030210> "abnormal genioglossus morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030210> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030210> "MP:0030210")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030210> "abnormal genioglossus muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030210> <http://purl.obolibrary.org/obo/MP_0030209>)

# Class: <http://purl.obolibrary.org/obo/MP_0030211> (abnormal styloglossus muscle morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.gpnotebook.co.uk/simplepage.cfm?ID=503709774") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030211> "any structural anomaly of the paired extrinsic tongue muscle that arises from the anterior surface of the styloid process of the mastoid bone and the proximal quarter of the stylohyoid ligament; it passes inferiorly and anteriorly to insert into the side and inferior aspects of the tongue; the muscle fibers of styloglossus merge with those of the hyoglossus; its action aids to retract the tongue and draw up the sides of the tongue to create a trough for swallowing")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030211> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030211> "2017-09-28T09:49:01Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030211> "abnormal styloglossus morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030211> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030211> "MP:0030211")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030211> "abnormal styloglossus muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030211> <http://purl.obolibrary.org/obo/MP_0030209>)

# Class: <http://purl.obolibrary.org/obo/MP_0030212> (abnormal hyoglossus muscle morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Hyoglossus") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030212> "any structural anomaly of the thin, quadrilateral extrinsic tongue muscle that arises from the side of the body and from the whole length of the greater cornu of the hyoid bone, and passes almost vertically upward to enter the side of the tongue, between the styloglossus and the inferior longitudinal muscle of the tongue; its action depresses and retracts the tongue and makes the dorsum more convex")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030212> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030212> "2017-09-28T09:57:57Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030212> "abnormal hyoglossus morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030212> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030212> "MP:0030212")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030212> "abnormal hyoglossus muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030212> <http://purl.obolibrary.org/obo/MP_0030209>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031727> "inverted P waves")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031727> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0031727> "retrograde P wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031727> "MP:0031727")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031727> "P wave inversion")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031727> <http://purl.obolibrary.org/obo/MP_0004070>)


# Class: <http://purl.obolibrary.org/obo/MP_0010171> (abnormal centroacinar cell of Langerhans morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CL:0002080") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0010171> "any structural anomaly of the cubodial epithelial cell that is continuous with the lining of intercalated ducts that drain the pancreatic acinus; this cell type secretes a high pH solution to aid in activation of zymogens, and can differentiate into endocrine and exocrine pancreatic cell types")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0010171> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0010171> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0010171> "2010-06-01T02:40:50Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010171> "abnormal centro-acinar cell of Langerhans morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010171> "abnormal pancreatic centro-acinar cell morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010171> "abnormal pancreatic centroacinar cell morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0010171> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010171> "MP:0010171")
AnnotationAssertion(Annotation(rdfs:comment "PMID:20018761") Annotation(rdfs:comment "https://doi.org/10.1016/B978-0-323-34062-5.00004-2") rdfs:comment <http://purl.obolibrary.org/obo/MP_0010171> "Centroacinar cells liet at the junction between the acinus and the ductal cells of the intercalated duct, are smaller than acinar cells, have a high nuclear-to-cytoplasm ratio, and have long cytoplasmic processes that allow contact with other cells (i.e., centroacinar, acinar, and islet cells). Some authors suggest that centroacinar cells could represent progenitor multipotent pancreatic cells and potentially be involved in malignant transformation")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010171> "abnormal centroacinar cell of Langerhans morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0010171> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0002080>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010171> <http://purl.obolibrary.org/obo/MP_0009145>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010171> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001263>)))

# Class: <http://purl.obolibrary.org/obo/MP_0010172> (abnormal mammary gland epithelium physiology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://umr144.curie.fr/en/research-groups/molecular-mechanisms-mammary-gland-development-marina-glukhova/molecular-mechanisms-") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0010172> "any functional anomaly of the mammary gland epithelium which is normally enveloped by a basement membrane, embedded into fatty connective tissue stroma, and organized as a bilayer, with an inner luminal layer of secretory epithelial cells, and an outer basal layer; each cell layer expresses specific molecular markers; luminal epithelial cells are characterized by the expression of the receptors for systemic hormones, i.e. estrogens, progesterone and prolactin, whereas basal cells (aka myoepithelial cells) express smooth muscle contractile proteins; in functionally differentiated mammary gland, during lactation, luminal cells produce milk, whereas myoepithelial cells are contractile and serve for milk expulsion")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0010172> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0010172> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0010172> "2010-06-01T02:55:12Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0010172> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010172> "MP:0010172")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010172> "abnormal mammary gland epithelium physiology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010172> <http://purl.obolibrary.org/obo/MP_0001881>)


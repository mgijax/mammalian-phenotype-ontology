AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0003842> "abnormal mediofrontal suture morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0003842> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0003842> "MP:0003842")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0003842> "abnormal metopic suture morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0003842> <http://purl.obolibrary.org/obo/MP_0002835>)


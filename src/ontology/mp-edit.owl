AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030516> "MP:0030516")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030516> "abnormal junctional epithelium morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030516> <http://purl.obolibrary.org/obo/MP_0020460>)


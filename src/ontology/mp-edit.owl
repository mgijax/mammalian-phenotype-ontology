# Class: <http://purl.obolibrary.org/obo/MP_0014096> (abnormal pancreatic amylase secretion)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Amylase") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.newworldencyclopedia.org/entry/Pancreas") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0014096> "anomaly in the production and/or release of alpha-amylase, the main starch digesting enzyme component of pancreatic juice, from the acinar cells of the exocrine pancreas; pancreatic alpha-amylase is released into pancreatic ducts in its active form and acts at random locations along the starch chain to break down long-chain carbohydrates, ultimately yielding maltotriose and maltose from amylose, or maltose, glucose and limit dextrin from amylopectin")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014096> "abnormal pancreatic alpha-amylase secretion")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0014096> "MP:0014096")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0014096> "Amylase is present in salivary gland secretions and in pancreatic acinar cell secretions in most mammals.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0014096> "abnormal pancreatic amylase secretion")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0014096> <http://purl.obolibrary.org/obo/MP_0002694>)

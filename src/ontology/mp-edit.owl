AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0011834> "abnormal clitoral gland morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0011834> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0011834> "MP:0011834")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0011834> "abnormal female preputial gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011834> <http://purl.obolibrary.org/obo/MP_0013324>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011834> <http://purl.obolibrary.org/obo/MP_0013329>)

# Class: <http://purl.obolibrary.org/obo/MP_0011835> (abnormal urogenital fold morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0011835> "any structural anomaly of the pair of folds derived from the cloacal folds which give rise to a portion of the external genitalia; in male embryos they close over the urethral plate and fuse to form the spongy (penile) urethra and ventral aspect of the penis, not including the glans; failure of fusion of the urethral folds leads to hypospadias; in female embryos they fuse only anterior to the anus and form the labia minora")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0011835> <https://orcid.org/0000-0003-3691-0324>)

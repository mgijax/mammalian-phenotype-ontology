AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0030301> "abnormal nasal process of the maxilla morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030301> "MP:0030301")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030301> "abnormal maxillary frontal process morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030301> <http://purl.obolibrary.org/obo/MP_0000455>)


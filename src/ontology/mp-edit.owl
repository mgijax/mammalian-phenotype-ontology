AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0012540> "abnormal terminal plate morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0012540> "abnormal velum terminale morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0012540> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0012540> "MP:0012540")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012540> "abnormal lamina terminalis morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012540> <http://purl.obolibrary.org/obo/MP_0002151>)


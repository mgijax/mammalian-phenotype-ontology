AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0014726> "2025-08-14T20:43:32Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0014726> "MP:0014726")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0014726> "structural and functional changes include: decrease in proliferative capacity, accumulation of binucleate and polyploid cells, hypertrophy, increase of sarcomere length and alignment, myofibril expansion, and increase in mitochondrial number and size")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0014726> "abnormal cardiomyocyte maturation")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0014726> <http://purl.obolibrary.org/obo/MP_0000267>)


# Class: <http://purl.obolibrary.org/obo/MP_0031313> (spondylolisthesis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Spondylolisthesis") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medicinenet.com/spondylolisthesis/article.htm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031313> "a condition of the spine whereby one of the vertebra slips forward or backward in relation to the next vertebra; forward slippage of an upper vertebra on a lower vertebra is referred to as anterolisthesis, while backward slippage is referred to as retrolisthesis")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031313> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031313> "2021-10-25T09:40:22Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031313> "spondylolistheses")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MP_0031313> "anterolisthesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MP_0031313> "retrolisthesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031313> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031313> "MP:0031313")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031313> "Spondylolisthesis can lead to a deformity of the spine as well as a narrowing of the spinal canal (central spinal stenosis) or compression of the exiting nerve roots (foraminal stenosis). Spondylolisthesis is most common in the low back (lumbar spine) but can also occur in the mid to upper back (thoracic spine) and neck (cervical spine).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031313> "spondylolisthesis")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031313> <http://purl.obolibrary.org/obo/MP_0004703>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031313> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001130>)))


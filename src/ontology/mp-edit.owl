# Class: <http://purl.obolibrary.org/obo/MP_0030159> (abnormal tensor tympani muscle morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030159> "any structural anomaly of the tiny striated muscle that originates superior to the pharyngotympanic tube, the sphenoid, and the temporal bone and inserts into the handle of the malleus; it tenses the tympanic membrane and dampens the movements of the auditory ossicles to prevent ear damage from loud sounds; it is innervated by the trigeminal nerve")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030159> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030159> "2017-09-21T10:51:26Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030159> "http://www.dummies.com/education/science/anatomy/the-anatomy-of-the-middle-ear/")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030159> "abnormal tensor tympani morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030159> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030159> "MP:0030159")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030159> "abnormal tensor tympani muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030159> <http://purl.obolibrary.org/obo/MP_0030156>)

# Class: <http://purl.obolibrary.org/obo/MP_0030160> (abnormal auditory bulla morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Tympanic_part_of_the_temporal_bone") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030160> "any structural anomaly of the hollow bony structure on the ventral, posterior portion of the skull that encloses parts of the middle and inner ear; in most species, it is formed by the tympanic part of the temporal bone")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030160> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030160> "2017-09-21T11:33:05Z"^^xsd:dateTime)

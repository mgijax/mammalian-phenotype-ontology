AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030851> "abnormal iliac fossa morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030851> <http://purl.obolibrary.org/obo/MP_0005354>)


AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013609> "abnormal ovarian medulla morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013609> <http://purl.obolibrary.org/obo/MP_0001126>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031114> "increased circulating gamma-glutamyl transpeptidase level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031114> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031114> "MP:0031114")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031114> "increased circulating gamma-glutamyl transferase level")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031114> <http://purl.obolibrary.org/obo/MP_0014450>)

# Class: <http://purl.obolibrary.org/obo/MP_0031115> (macrovesicular hepatic steatosis)


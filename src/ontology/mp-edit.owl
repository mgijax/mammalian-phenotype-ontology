AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0003899> "A prolonged QT interval is a risk factor for ventricular tachyarrhythmias and sudden death. It varies with heart rate and for clinical relevance requires a correction for this, giving the QTc.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0003899> "abnormal QT interval")

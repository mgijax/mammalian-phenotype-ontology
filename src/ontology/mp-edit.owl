AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013559> "MP:0013559")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013559> "abnormal exocrine gland physiology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013559> <http://purl.obolibrary.org/obo/MP_0002164>)

# Class: <http://purl.obolibrary.org/obo/MP_0013560> (abnormal endocrine gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0002368") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013560> "any structural anomaly of any of the glands of the endocrine system that secrete their products directly into the circulatory system rather than through a duct")

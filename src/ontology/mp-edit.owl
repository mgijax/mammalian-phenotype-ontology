# Class: <http://purl.obolibrary.org/obo/MP_0002432> (abnormal CD4-positive, alpha beta T cell morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MESH:A11.118.637.555.567.569.200") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MGI:cwg") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0002432> "any structural anomaly of the subset of T lymphocytes that carry the CD4 marker, recognize intravesicular peptides bound to MHC class-II molecules, and turn on antibody production")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/MP_0002432> "abnormal single positive T cell morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0002432> "CD4+ T-cell abnormalities")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0002432> "abnormal CD4+ T cell morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0002432> "abnormal CD4-positive T cell morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0002432> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0002432> "MP:0002432")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0002432> "Generally, when immunologists write CD8 positive T cell, what they mean is CD8-positive, alpha-beta T cell (CL:0000625).  Similarly, when immunologists write CD4 positive T cell, what they mean is CD4-positive, alpha-beta T cell (CL:0000624).  T cells bearing the alpha-beta T cell receptor are the most common in the body, and are the most commonly studied, so much so, that in many published papers, the authors do not even bother to specify (or assume) they are studying alpha-beta T cells and thus omit saying so.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0002432> "abnormal CD4-positive, alpha beta T cell morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0002432> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0000624>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

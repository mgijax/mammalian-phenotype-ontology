# Class: <http://purl.obolibrary.org/obo/MP_0031348> (bone fibrous dysplasia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Fibrous_dysplasia_of_bone") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://rarediseases.org/rare-diseases/fibrous-dysplasia/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031348> "normal bone and marrow is replaced with scar-like (fibrous) connective tissue, resulting in formation of bone that is weak and prone to expansion")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031348> "2022-02-01T10:29:40Z"^^xsd:dateTime)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031348> <https://orcid.org/0000-0001-5858-4393>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031348> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5858-4393>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031348> "fibro-osseous lesions")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031348> "fibrous dysplasia of bone")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031348> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031348> "MP:0031348")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ntp.niehs.nih.gov/atlas/nnl/musculoskeletal-system/bone/Fibro-osseousLesion") rdfs:comment <http://purl.obolibrary.org/obo/MP_0031348> "Per NIEHS pathologists, fibro-osseous lesions (FOLs) are characterized by proliferation of stroma (supportive tissue consisting of connective tissue and blood vessels) with proliferation of osteoblasts and osteoclasts cell populations. According to the Nonneoplastic Lesion Atlas, FOLs show partial or complete replacement of bony trabeculae and marrow cavity by fibrovascular stroma containing fibroblasts, osteoclasts, and osteoblasts embedded in eosinophilic matrix. The histopathologic features are similar to fibrous osteodystrophy; however, FOLs occur in the absence of parathyroid or renal alterations, typically arise as focal lesions within the metaphyseal or endocortical regions, and may progress to involve larger areas of the bone.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031348> "bone fibrous dysplasia")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031348> <http://purl.obolibrary.org/obo/MP_0003795>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031348> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001474>)))


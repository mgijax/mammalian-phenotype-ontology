# Class: <http://purl.obolibrary.org/obo/MP_0030619> (homogentisic aciduria)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25003018") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030619> "excretion of excessive amounts of homogentisic acid (an intermediate in the tyrosine degradation pathway) and its oxidized form (benzoquinoneacetate) in the urine, giving it an unusually dark color on prolonged exposure to air")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030619> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030619> "2018-08-24T11:55:51Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030619> "increased urine homogentisic acid level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030619> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030619> "MP:0030619")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25003018") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8188247") rdfs:comment <http://purl.obolibrary.org/obo/MP_0030619> "Homogentisic aciduria is one of the three distinct clinical features of alkaptonuria (AKU), along with ochronosis and ochronotic osteoarthropathy; the darkening of urine occurs because the HGA pigment oxidizes to benzoquinoneacetate (BQA), which forms a melanin-like polymer that slowly turns urine black")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030619> "homogentisic aciduria")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030619> <http://purl.obolibrary.org/obo/MP_0010028>)


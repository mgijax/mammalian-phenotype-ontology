# Class: <http://purl.obolibrary.org/obo/MP_0030839> (abnormal acetabular notch morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0014446") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Acetabular_notch") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://radiopaedia.org/articles/acetabular-notch") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030839> "any structural anomaly of the deep notch (depression) located anteroinferiorly along the margin of the acetabulum; it is bridged by the transverse ligament and thus forms the acetabular foramen through which nutrient vessels and nerves enter the hip joint; the ligamentum teres has part of its origin from the acetabular notch")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030839> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030839> "2018-10-03T08:36:27Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030839> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030839> "MP:0030839")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030839> "abnormal acetabular notch morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030839> <http://purl.obolibrary.org/obo/MP_0004509>)

# Class: <http://purl.obolibrary.org/obo/MP_0030840> (abnormal acetabular labrum morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=0323549667") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030840> "any structural anomaly of the horse-shaped fibrocartilaginous structure that attaches to the peripheral rim of the acetabulum, contacts the articular surface of the femoral head, and blends inferiorly with the transverse acetabular ligament; it increases the depth of the acetabulum, increasing static stability and contributes to hydrostatic pressurization of the intra-articular space, joint lubrication, and load distribution")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030840> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030840> "2018-10-03T09:12:31Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030840> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030840> "MP:0030840")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030840> "abnormal acetabular labrum morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030840> <http://purl.obolibrary.org/obo/MP_0030829>)

# Class: <http://purl.obolibrary.org/obo/MP_0030841> (abnormal transverse acetabular ligament morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.anatomyexpert.com/app/structure/15415/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Transverse_acetabular_ligament") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030841> "any structural anomaly of the fibrous continuation of the acetabular labrum that is completely collagenous and contains no chondrocytes or cartilage; it consists of strong, flattened fibers which cross the acetabular notch and convert it into the acetabular foramen through which nutrient vessels and nerves enter the hip joint; it prevents inferior displacement of head of femur")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030841> <https://orcid.org/0000-0002-6490-7723>)

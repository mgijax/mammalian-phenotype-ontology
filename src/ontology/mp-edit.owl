# Class: <http://purl.obolibrary.org/obo/MP_0010784> (abnormal forestomach morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0849366887") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://ctrgenpath.net/static/atlas/mousehistology/Windows/digestive/forestomach.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0010784> "any structural anomaly of the distinct rodent non-glandular region of the stomach which is demarcated from the glandular stomach by the limiting ridge (margo plicatus); the forestomach accounts for about 60% (rat) and 70% (mouse) of the stomach volume and receives the esophagus at the cardiac antrum; the wall of the forestomach consists of, from inside to outside, stratified squamous epithelium, the lamina propria (epithelium and lamina propria form the mucosa), the muscularis mucosae, the submucosa, the muscularis interna and externa (inner circular and outer longitudinal layers of smooth muscle), and the serosa")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0010784> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0010784> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0010784> "2011-02-08T11:05:59Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010784> "abnormal anterior stomach morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010784> "abnormal antrum cardiacum morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010784> "abnormal non-glandular stomach morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010784> "abnormal proximal stomach morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010784> "abnormal stomach cardiac antrum morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010784> "abnormal stomach non-glandular region morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0010784> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010784> "MP:0010784")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0010784> "The forestomach is not present in humans.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010784> "abnormal forestomach morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010784> <http://purl.obolibrary.org/obo/MP_0000470>)


# Class: <http://purl.obolibrary.org/obo/MP_0030850> (abnormal ilium body morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0010747") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.anatomyexpert.com/app/structure/127/833/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030850> "any structural anomaly of the thick lower part (base) of the ilium that forms about the upper two-fifths of the acetabulum; its external surface is partly articular, partly non-articular; the articular segment forms part of the lunate surface of the acetabulum, the non-articular portion contributes to the acetabular fossa; the internal surface of the body is part of the wall of the lesser pelvis and gives origin to some fibers of the obturator internus; below, it is continuous with the pelvic surfaces of the ischium and pubis, only a faint line indicating the place of union")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030850> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030850> "2018-10-09T12:03:10Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030850> "abnormal iliac bone body morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030850> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030850> "MP:0030850")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030850> "abnormal ilium body morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030850> <http://purl.obolibrary.org/obo/MP_0005354>)

# Class: <http://purl.obolibrary.org/obo/MP_0030851> (abnormal iliac fossa morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Iliac_fossa") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030851> "any structural anomaly of the large, smooth, concave surface on the internal surface of the ilium; the fossa is bounded above by the iliac crest, below by the arcuate line, and in front and behind, by the anterior and posterior borders of the ilium; it gives origin to the iliacus muscle")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030851> <https://orcid.org/0000-0002-6490-7723>)

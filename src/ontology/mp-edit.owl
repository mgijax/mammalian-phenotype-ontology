AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010010> "MP:0010010")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0010010> "The islands of Calleja are located within the olfactory tubercle in most species; however, in primates these islands are located within the nucleus accumbens, since the olfactory tubercle is absent or extremely rudimentary in the brains of primates. We have currently placed this term as a child of both abnormal nucleus accumbens morphology and abnormal olfactory tubercle morphology but we may need to reconsider this placement.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010010> "abnormal islands of Calleja morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010010> <http://purl.obolibrary.org/obo/MP_0004080>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010010> <http://purl.obolibrary.org/obo/MP_0009953>)


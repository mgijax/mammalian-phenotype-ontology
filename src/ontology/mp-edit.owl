# Class: <http://purl.obolibrary.org/obo/MP_0012710> (diastematomyelia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0012710> "a rare congenital anomaly that results in the splitting of the spinal cord in a longitudinal direction, usually at the level of the upper lumbar vertebra; this condition occurs in the presence of an osseous (bone), cartilaginous or fibrous septum in the central portion of the spinal canal which then produces a complete or incomplete sagittal division of the spinal cord into two hemicords, each half being surrounded by a dural sac; when the split does not reunite distally to the spur, the condition is referred to as a diplomyelia")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0012710> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0012710> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0012710> "2014-03-20T14:10:17Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0012710> "diastomyelia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0012710> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0012710> "MP:0012710")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012710> "diastematomyelia")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012710> <http://purl.obolibrary.org/obo/MP_0000955>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012710> <http://purl.obolibrary.org/obo/MP_0005297>)


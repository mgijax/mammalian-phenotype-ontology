AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0004841> "MP:0004841")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004841> "abnormal small intestine crypts of Lieberkuhn morphology")

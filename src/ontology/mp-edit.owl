AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014503> "reduced circulating myoglobin level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0014503> "MP:0014503")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0014503> "decreased circulating myoglobin level")

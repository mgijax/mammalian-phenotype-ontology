AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013582> "abnormal glandula nasalis lateralis morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013582> "MP:0013582")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013582> "abnormal lateral nasal gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013582> <http://purl.obolibrary.org/obo/MP_0013580>)


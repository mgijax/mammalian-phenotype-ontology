# Class: <http://purl.obolibrary.org/obo/MP_0013781> (abnormal mammary gland luminal epithelium morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:8793237073") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://umr144.curie.fr/en/research-groups/molecular-mechanisms-mammary-gland-development-marina-glukhova/molecular-mechanisms-") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013781> "any structural anomaly of the inner cell layer of the mammary epithelium bilayer that lines the luminal surface of mammary gland ducts and alveoli; luminal cells have only limited contact with the underlying basement membrane and surrounding connective tissue; they are secretory epithelial cells characterized by the expression of the receptors for systemic hormones, i.e. estrogens, progesterone and prolactin")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013781> "MP:0013781")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013781> "abnormal mammary gland luminal epithelium morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013781> <http://purl.obolibrary.org/obo/MP_0009504>)

# Class: <http://purl.obolibrary.org/obo/MP_0013782> (abnormal mammary duct terminal end bud morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16280048") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16916375") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18296651") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013782> "any structural anomaly of the unique club-shaped epithelial structure that develops at the tip of the mammary duct at the onset of puberty (approximately 3 weeks of age in mouse) under the action of circulating hormones; terminal end buds (TEBs) consist of an outer layer of undifferentiated myoepithelial progenitor cells (cap cells), and a multilayered inner core of luminal epithelial cells (body) fated to form the walls of the ductal lumen; both layers have high rates of mitosis, consistent with a motile organ dedicated to ductal morphogenesis; TEBs proliferate, ramify, and actively invade the fad pad to allow the formation of a complex branching structure; this process of branching morphogenesis concludes at about 10-12 weeks of age in mouse, when TEBs have traversed the length of the fat pad and a fully developed ductal tree has formed")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013782> "abnormal mammary duct TEB morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013782> "MP:0013782")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013782> "abnormal mammary duct terminal end bud morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013782> <http://purl.obolibrary.org/obo/MP_0009503>)

# Class: <http://purl.obolibrary.org/obo/MP_0013783> (absent mammary duct terminal end bud)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16280048") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16916375") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18296651") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013783> "failure to develop or maintain the unique club-shaped epithelial structure normally formed at the tip of the mammary duct at the onset of puberty (approximately 3 weeks of age in mouse) under the action of circulating hormones; normally, TEBs proliferate, ramify, and actively invade the fad pad to allow the formation of a complex branching structure; this process of branching morphogenesis concludes at about 10-12 weeks of age in mouse, when TEBs have traversed the length of the fat pad and a fully developed ductal tree has formed; absence of TEBs is often associated with reduced ductal outgrowth and impaired branching morphogenesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013783> "absent mammary duct TEB")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013783> "MP:0013783")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013783> "absent mammary duct terminal end bud")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0013783> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000462> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0005313>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013783> <http://purl.obolibrary.org/obo/MP_0031174>)

# Class: <http://purl.obolibrary.org/obo/MP_0013784> (abnormal mammary gland bud elongation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25467960") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013784> "any anomaly in the process in which a mammary bud grows along its axis; in mouse embryos, the distal end of the mammary bud begins to elongate into the underlying dermal mesenchyme to form a mammary cord (sprout) by E15.5")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013784> "MP:0013784")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013784> "abnormal mammary gland bud elongation")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0013784> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0060649>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013784> <http://purl.obolibrary.org/obo/MP_0004135>)

# Class: <http://purl.obolibrary.org/obo/MP_0013785> (abnormal mammary gland bud morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12558599") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.informatics.jax.org/greenbook/frames/frame13.shtml") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013785> "any structural anomaly of the morphologically distinct bulb of epithelial cells formed once each mammary placode expands and invaginates into the underlying mesenchyme; in mouse embryos at E12.5, each epithelial bud with its contiguous mesenchyme is elevated above the surrounding ectoderm as a knob or dome; at E13.5, the buds sink into the underlying dermal mesenchyme, and by E14.5 they can no longer be detected externally; in female mouse embryos, five pairs of anlagen or buds are formed along the mammary line between E12.5 and E14.5 by proliferation of basal epidermal cells; while further mammary development is temporarily arrested in females, androgen receptor activation in male embryos causes degeneration of the buds between E13.5 and E15.5; in female mice, further development is resumed at around E15.5 when each bud elongates to form a mammary cord (sprout), invading the underlying fat pad precursor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013785> "abnormal lactiferous gland bud morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013785> "abnormal mammary bud morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013785> "abnormal milk bud morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013785> "MP:0013785")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0013785> "In male mouse embryos the bud separates from the epidermis by testosterone-dependent mechanisms between E14.5 and E15.5, and subsequently degenerates; male mice have no nipples and usually only four pairs of rudimentary glands consisting of branching ducts with no aveoli, primary ducts, or openings to the exterior.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013785> "abnormal mammary gland bud morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013785> <http://purl.obolibrary.org/obo/MP_0004135>)

# Class: <http://purl.obolibrary.org/obo/MP_0013786> (abnormal mammary gland bud formation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20484386") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013786> "any anomaly in the morphogenetic process in which a distinct bulb of epithelial cells forms from a mammary placode")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013786> "abnormal lactiferous gland bud formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013786> "abnormal mammary bud formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013786> "abnormal milk bud formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013786> "MP:0013786")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0013786> "In mice, as the cells from the placode begin to invaginate into the underlying mesenchyme they pile up at the surface and begin to array themselves in a concentric orientation so that the early bud is elevated above the plane of the surrounding epidermis; as a result, at E12, the developing buds are visible as prominent knobs on the ventral surface of the embryo, which then submerge beneath the plane of the skin; the formation of the epithelial bud is accompanied by dramatic changes in the underlying mesenchyme; cells surrounding the epithelium elongate, condense, and orient their long axis in a radial fashion around the developing epithelial cells; at the end of this process, the mature bud consists of a sphere of concentrically arrayed epithelial cells connected to the skin surface by a stalk of epidermal-like cells; both ball and stalk are, in turn, surrounded by three to five layers of condensed mesenchyme, referred to as the primary mammary mesenchyme; in female mice the mammary buds remain relatively quiescent from E14 to E16, when ductal morphogenesis commences; in male mice, the mesenchyme around the stalk enlarges and condenses further, eventually severing the connection to the skin; this is followed by apoptosis of the mammary mesenchyme and many cells within the epithelial bud as well; consequently, male mice have either no mammary epithelial ducts or only very rudimentary ones.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013786> "abnormal mammary gland bud formation")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0013786> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0060615>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013786> <http://purl.obolibrary.org/obo/MP_0004135>)

# Class: <http://purl.obolibrary.org/obo/MP_0013787> (photophobia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Photophobia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013787> "abnormal aversion or avoidance behavior in response to light; photophobia is symptom of abnormal intolerance to visual perception of light; as a medical symptom, photophobia is not a morbid fear or phobia, but an experience of discomfort or pain to the eyes due to light exposure or by presence of actual physical sensitivity of the eyes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013787> "avoidance of light")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013787> "light-aversive behavior")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013787> "light-aversive behaviour")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013787> "MP:0013787")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013787> "photophobia")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0013787> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001698> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0000019>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013787> <http://purl.obolibrary.org/obo/MP_0001999>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013787> <http://purl.obolibrary.org/obo/MP_0011275>)


AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0009281> "abnormal hyperactivated sperm motility")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0009281> <http://purl.obolibrary.org/obo/MP_0002674>)


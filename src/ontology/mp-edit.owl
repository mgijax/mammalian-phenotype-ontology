# Class: <http://purl.obolibrary.org/obo/MP_0013318> (abnormal branching involved in seminal vesicle morphogenesis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16916376") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013318> "anomaly in the process in which the seminal vesicle is generated and organized in many mammals including mice and humans; in mice, the initial seminal vesicle buds form cane-shaped tubes off of the Wolffian ducts before birth; after birth, the initial tubes develop lateral branches that elongate and often undergo secondary branching morphogenesis; branching morphogenesis is largely complete by 2 weeks of age")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013318> "abnormal branching involved in gonecyst morphogenesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013318> "abnormal branching involved in seminal gland morphogenesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013318> "MP:0013318")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0013318> "The seminal vesicles are present as branched organs in many mammals including mice and humans. However, the seminal vesicles are completely absent from some mammals including monotremes, marsupials, carnivores, and cetaceans. In addition, the seminal vesicles in some mammals such as the guinea-pig are present as unbranched tubular glands.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013318> "abnormal branching involved in seminal vesicle morphogenesis")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013318> <http://purl.obolibrary.org/obo/MP_0013317>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013318> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0000998>)))


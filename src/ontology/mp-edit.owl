AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031725> "MP:0031725")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031725> "abnormal podosome physiology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031725> <http://purl.obolibrary.org/obo/MP_0014241>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013749> "MP:0013749")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013749> "abnormal parotid interlobular duct morphology")

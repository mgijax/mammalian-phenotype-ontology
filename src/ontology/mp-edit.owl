AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013010> "abnormal post-otic neural crest cell morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013010> "abnormal vagal NCC morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0013010> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013010> "MP:0013010")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013010> "abnormal vagal neural crest cell morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013010> <http://purl.obolibrary.org/obo/MP_0009845>)


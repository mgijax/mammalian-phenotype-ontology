AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031347> "MP:0031347")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031347> "This term should be used for vascular related redness, not the red eyes seen in albinism.")

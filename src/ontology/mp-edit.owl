AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-3691-0324>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0012289> "any anomaly in the frequency or duration of the sleep stages characterized by distinct EEG patterns, decreased metabolic activity, slowed breathing and heart rate, and the absence of rapid eye movement and dreaming")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0012289> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0012289> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0012289> "2013-11-14T13:01:55Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0012289> "abnormal NREM sleep pattern")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0012289> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0012289> "MP:0012289")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0012289> "NREM sleep was divided into four stages in the Rechtschaffen and Kales (R&K) standardization of 1968. That has been reduced to three in the 2007 update by The American Academy of Sleep Medicine (AASM), combining the previous stage 3 and 4 to a single stage 3 also known as deep sleep or slow-wave sleep. The three stages that comprise NREM sleep account for 75-80 percent of total sleep time in humans.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012289> "abnormal non-rapid eye movement sleep pattern")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012289> <http://purl.obolibrary.org/obo/MP_0001501>)


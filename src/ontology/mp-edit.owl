AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030557> "abnormal cementocyte dendritic process morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030557> <http://purl.obolibrary.org/obo/MP_0030554>)


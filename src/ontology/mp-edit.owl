AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27029548") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=0323058442") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://medicine.academic.ru/110777/cementoid") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030548> "any structural anomaly of the organic matrix secreted by cementoblasts, which forms the most recent unmineralized layer covering the surface of cellular cementum")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0001664") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK459388/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK532954/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031712> "a type of polymorphic ventricular tachycardia characterized by oscillatory changes in amplitude of the QRS complexes around the isoelectric line, giving it the name 'twisting of the points'; it is associated with QTc prolongation, which is the heart rate adjusted lengthening of the QT interval, and the rhythm may terminate spontaneously or may degenerate into ventricular fibrillation")

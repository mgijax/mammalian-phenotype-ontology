AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030146> "abnormal digastric posterior belly morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030146> <http://purl.obolibrary.org/obo/MP_0013815>)

# Class: <http://purl.obolibrary.org/obo/MP_0030147> (abnormal digastric muscle physiology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030147> "any functional anomaly of the digastric muscle whose action elevates the hyoid when the mandible is fixed and depresses the mandible when the hyoid is fixed; when the two bellies of the digastric contract, they pull upward on the hyoid bone; but if the hyoid is fixed from below, the digastric assists in extreme opening of the mouth such as yawning or taking a large bite")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030147> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030147> "2017-09-18T08:56:48Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030147> "https://en.wikipedia.org/wiki/Suprahyoid_muscles")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030147> "abnormal digastricus physiology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030147> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030147> "MP:0030147")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030147> "abnormal digastric muscle physiology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030147> <http://purl.obolibrary.org/obo/MP_0030144>)

# Class: <http://purl.obolibrary.org/obo/MP_0030148> (abnormal mylohyoid muscle morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030148> "any structural anomaly of the flat and triangular paired muscle that runs from the mandible to the hyoid bone forming the muscular floor of the oral cavity of the mouth; it is a suprahyoid muscle derived from the first pharyngeal arch that is situated immediately superior to the anterior belly of the digastric muscle")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030148> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030148> "2017-09-18T09:47:34Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030148> "https://en.wikipedia.org/wiki/Mylohyoid_muscle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030148> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030148> "MP:0030148")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030148> "abnormal mylohyoid muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030148> <http://purl.obolibrary.org/obo/MP_0030240>)

# Class: <http://purl.obolibrary.org/obo/MP_0030149> (abnormal stylohyoid muscle morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030149> "any structural anomaly of the slender suprahyoid muscle lying anterior and superior of the posterior belly of the digastric muscle; it arises from the styloid process of the temporal bone and inserts into the body of the hyoid bone; it is perforated, near its insertion, by the intermediate tendon of the digastric muscle; the stylohyoid elevates and retracts the hyoid bone, elongating the floor of the mouth during swallowing")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030149> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030149> "2017-09-18T10:28:26Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030149> "https://en.wikipedia.org/wiki/Stylohyoid_muscle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030149> "https://en.wikipedia.org/wiki/Suprahyoid_muscles")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030149> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030149> "MP:0030149")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030149> "abnormal stylohyoid muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030149> <http://purl.obolibrary.org/obo/MP_0030240>)

# Class: <http://purl.obolibrary.org/obo/MP_0030150> (absent stylohyoid muscle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Stylohyoid_muscle") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Suprahyoid_muscles") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030150> "absence of the slender suprahyoid muscle lying anterior and superior of the posterior belly of the digastric muscle that elevates and retracts the hyoid bone, elongating the floor of the mouth during swallowing")

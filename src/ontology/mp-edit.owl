# Class: <http://purl.obolibrary.org/obo/MP_0030151> (abnormal buccinator muscle morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030151> "any structural anomaly of the thin quadrilateral muscle occupying the interval between the maxilla and the mandible at the side of the face that forms the anterior part of the cheek or the lateral wall of the oral cavity; it compresses the cheeks against the teeth and is used in acts such as blowing; it is an assistant muscle of mastication and in neonates it is used to suckle")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030151> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030151> "2017-09-18T11:59:36Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030151> "https://en.wikipedia.org/wiki/Buccinator_muscle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030151> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030151> "MP:0030151")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030151> "abnormal buccinator muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030151> <http://purl.obolibrary.org/obo/MP_0030039>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030151> <http://purl.obolibrary.org/obo/MP_0030246>)

# Class: <http://purl.obolibrary.org/obo/MP_0030152> (abnormal depressor anguli oris muscle morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030152> "any structural anomaly of the facial muscle that originates from the mandible and inserts into the angle of the mouth; it is innervated by the marginal mandibular branch of the facial nerve and receives its blood supply from the facial artery; the muscle depresses the corners of the mouth which is associated with frowning")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030152> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030152> "2017-09-18T12:37:33Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MP_0030152> "https://en.wikipedia.org/wiki/Depressor_anguli_oris_muscle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030152> "abnormal triangularis muscle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030152> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030152> "MP:0030152")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030152> "abnormal depressor anguli oris muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030152> <http://purl.obolibrary.org/obo/MP_0030039>)


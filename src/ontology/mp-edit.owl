# Class: <http://purl.obolibrary.org/obo/MP_0014594> (abnormal sperm cytoplasmic droplet morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0097598>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0014594> "any structural anomaly in the small amount of cytoplasm surrounded by a cell membrane that may be retained in the spermatozoa after spermiogenesis")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0014594> <https://orcid.org/0000-0003-4606-0597>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0014594> "2024-12-18T20:34:15Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0014594> "abnormal sperm residual cytoplasm morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0014594> "MP:0014594")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0097598>) rdfs:comment <http://purl.obolibrary.org/obo/MP_0014594> "Initially, the droplet is located at the neck just behind the head of an elongated spermatid. During epididymal transit, the cytoplasmic droplet migrates caudally to the annulus at the end of the midpiece; the exact position and time varies by species. The cytoplasmic droplet consists of lipids, lipoproteins, RNAs, a variety of hydrolytic enzymes, receptors, ion channels, and Golgi-derived vesicles. The droplet may be involved in regulatory volume loss (RVD) at ejaculation, and in most species, though not in humans, the cytoplasmic droplet is lost at ejaculation. Note that the cytoplasmic droplet is distinct from 'excessive residual cytoplasm' that sometimes remains in epididymal spermatozoa, particularly when spermiogenesis has been disrupted.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0014594> "abnormal sperm cytoplasmic droplet morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0014594> <http://purl.obolibrary.org/obo/MP_0006362>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0014594> <http://purl.obolibrary.org/obo/MP_0014239>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030311> "MP:0030311")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030311> "abnormal mandibular fossa morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030311> <http://purl.obolibrary.org/obo/MP_0004423>)

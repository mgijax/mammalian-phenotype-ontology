AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010000> "MP:0010000")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0010000> "This is a structure present in rodents and is not present in humans. The cerebellum hemisphere structure and lobulation is dramatically different between these species.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010000> "abnormal copula pyramidis morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010000> <http://purl.obolibrary.org/obo/MP_0009963>)


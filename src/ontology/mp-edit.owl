AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030506> "abnormal dental sac morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030506> "abnormal tooth follicle morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030506> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030506> "MP:0030506")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030506> "abnormal dental follicle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030506> <http://purl.obolibrary.org/obo/MP_0000116>)

# Class: <http://purl.obolibrary.org/obo/MP_0030507> (abnormal dental papilla morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Dental_papilla") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030507> "any structural anomaly of the condensation of ectomesenchymal cells called odontoblasts seen in histologic sections of a developing tooth; the dental papilla lies below a cellular aggregation known as the enamel organ and differentiates into the dentin and dental pulp")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030507> <https://orcid.org/0000-0002-6490-7723>)

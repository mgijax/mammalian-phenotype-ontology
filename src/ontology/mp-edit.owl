AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0012252> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0012252> "MP:0012252")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012252> "abnormal septum transversum morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012252> <http://purl.obolibrary.org/obo/MP_0002085>)


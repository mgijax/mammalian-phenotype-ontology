# Class: <http://purl.obolibrary.org/obo/MP_0031356> (abnormal outer dense fiber morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29168316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://royalsocietypublishing.org/doi/10.1098/rsif.2018.0668") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031356> "any structural anomaly of the highly condensed, modified intermediate cytoskeletal filaments strengthened by disulfide linked keratin proteins that progress from the midpiece to the principal piece of the sperm tail; outer dense fibers are believed to maintain flagellar elasticity and play a role in the protection of the sperm tail against shear forces during epididymal transport and ejaculation")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031356> "2022-02-14T12:57:48Z"^^xsd:dateTime)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031356> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031356> "abnormal ODF morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031356> "abnormal outer dense fibre morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031356> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031356> "MP:0031356")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29168316") rdfs:comment <http://purl.obolibrary.org/obo/MP_0031356> "In the mammalian sperm tail, each ODF, which is numbered from 1 to 9 according to differences in cross-sectional shape and size, connects with one microtubular doublet of the axoneme resulting in a 9 + 9 + 2 cross-sectional pattern. In the principal piece, the fibrous sheath replaces ODFs 3 and 8, and the sizes of other ODFs progressively decrease distally. The shapes, sizes and lengths of ODFs are quite distinct in different species.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031356> "abnormal outer dense fiber morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0031356> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0001520>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031356> <http://purl.obolibrary.org/obo/MP_0008892>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031356> <http://purl.obolibrary.org/obo/MP_0020378>)


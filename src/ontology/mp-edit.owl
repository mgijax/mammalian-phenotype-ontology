AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030879> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030879> "MP:0030879")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030879> "abnormal syndesmosis morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030879> <http://purl.obolibrary.org/obo/MP_0030878>)

# Class: <http://purl.obolibrary.org/obo/MP_0030880> (abnormal infrapatellar fat pad morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25018130") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030880> "any structural anomaly of the partly adipose wedge-shaped mass formed in the anterior region of the knee that is intracapsular but extrasynovial (and thus extra-articular); it extends superiorly from the patella and alar folds to the tibia and infrapatellar bursa and is delimited anteriorly by the patellar ligament and joint capsule and posteriorly by the synovial membrane")

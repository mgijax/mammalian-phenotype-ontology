AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0009953> "MP:0009953")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0009953> "This structure does not exist in primates.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0009953> "abnormal olfactory tubercle morphology")

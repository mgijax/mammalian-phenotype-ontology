AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030537> "MP:0030537")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030537> "abnormal notochordal process morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030537> <http://purl.obolibrary.org/obo/MP_0012271>)

# Class: <http://purl.obolibrary.org/obo/MP_0030538> (abnormal notochordal plate morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0006267") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030538> "any structural anomaly of the dorsal part of the notochordal process when the ventral portion breaks down; it is continuous laterally with the endoderm that composes the roof of the primitive foregut and is in contact dorsally with the neural tube; the folding off of the notochordal plate gives rise to the notochord")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030538> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030538> "2018-01-12T14:19:48Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030538> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030538> "MP:0030538")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030538> "abnormal notochordal plate morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030538> <http://purl.obolibrary.org/obo/MP_0030537>)

# Class: <http://purl.obolibrary.org/obo/MP_0030539> (abnormal head paraxial mesoderm morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0009617") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=0123849527") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://discovery.lifemapsc.com/in-vivo-development/paraxial-mesoderm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030539> "any structural anomaly of the paraxial mesoderm located on either side of the neural tube, anterior to the occipital somites; in the head region, the unsegmented cranial paraxial mesoderm contributes to the developing heart, specific skull bones and skeletal muscles of the head and neck region")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030539> <https://orcid.org/0000-0002-6490-7723>)

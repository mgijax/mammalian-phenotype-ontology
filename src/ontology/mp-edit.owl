AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013966> "MP:0013966")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013966> "abnormal infrahyoid muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013966> <http://purl.obolibrary.org/obo/MP_0002253>)


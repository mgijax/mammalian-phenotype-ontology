AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030271> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030271> "MP:0030271")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030271> "abnormal foramen rotundum morphology")

# Class: <http://purl.obolibrary.org/obo/MP_0011843> (abnormal kidney collecting duct epithelium morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0011843> "any structural anomaly of the simple cuboidal epithelium lining the lumen of kidney collecting ducts; the mature and differentiated CD epithelium comprises two unique cells types with principal cells responsible for vasopressin-regulated water reabsorption, and intercalated cells regulating acid-base homeostasis; injury to the epithelium is believed to cause epithelial cells to acquire mesenchymal characteristics via epithelial-mesenchymal transition (EMT), a process through which tubular epithelial cells may transform into interstitial fibroblasts and promote renal fibrosis")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0011843> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0011843> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0011843> "2012-11-30T03:40:18Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0011843> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0011843> "MP:0011843")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0011843> "abnormal kidney collecting duct epithelium morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011843> <http://purl.obolibrary.org/obo/MP_0004754>)


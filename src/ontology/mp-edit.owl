AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030182> "abnormal nasobuccal membrane of Hochstetter morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030182> "abnormal oro-nasal membrane morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030182> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030182> "MP:0030182")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030182> "abnormal oronasal membrane morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030182> <http://purl.obolibrary.org/obo/MP_0030180>)


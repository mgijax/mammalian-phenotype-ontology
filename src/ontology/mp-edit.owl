# Class: <http://purl.obolibrary.org/obo/MP_0031127> (dry gangrene)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.pathwaymedicine.org/gangrenous-necrosis") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Gangrene#Dry_gangrene") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031127> "a form of coagulative necrosis that develops in ischemic tissue, where the blood supply is inadequate to keep tissue viable, in the absence of superimposed microbial infection; can be due to peripheral artery disease or acute limb ischemia; the affected body part is dry, shrunken, and dark reddish-black and can fall off (autoamputate) if not removed surgically")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031127> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031127> "2020-08-31T10:58:35Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031127> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031127> "MP:0031127")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Gangrene#Dry_gangrene") rdfs:comment <http://purl.obolibrary.org/obo/MP_0031127> "The term dry is used only when referring to a limb or to the gut; in other locations, this same type of necrosis is called an infarction, such as myocardial infarction")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031127> "dry gangrene")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031127> <http://purl.obolibrary.org/obo/MP_0031126>)

# Class: <http://purl.obolibrary.org/obo/MP_0031128> (cardiovascular shunt)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://radiopaedia.org/articles/cardiovascular-shunts") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031128> "an abnormal communication (shunt) between the right and left sides of the heart or between the systemic and pulmonary vessels, allowing blood to flow directly from one circulatory system to the other; blood can either be shunted from the systemic circulation to pulmonary circulation (i.e. left-to-right shunt) or between the pulmonary circulation and systemic circulation (i.e. right-to-left shunt); rarely, the shunted blood returns to the same cardiac chamber without traversing a capillary bed (i.e. circular shunt); most commonly shunts are the result of congenital heart disease")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031128> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031128> "2020-09-11T06:43:51Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MP_0031128> "cardiac shunt")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031128> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031128> "MP:0031128")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031128> "cardiovascular shunt")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031128> <http://purl.obolibrary.org/obo/MP_0002128>)

# Class: <http://purl.obolibrary.org/obo/MP_0031129> (left-to-right shunt)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18299514") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031129> "a left-to-right shunt allows the oxygenated, pulmonary venous blood to return directly to the lungs rather than being pumped to the body thereby reducing the cardiac output by the amount of the shunted volume; as a result, tissue oxygen delivery is reduced")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031129> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031129> "2020-09-11T06:55:18Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031129> "L-R shunt")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031129> "left-to-right shunting")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031129> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031129> "MP:0031129")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031129> "left-to-right shunt")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031129> <http://purl.obolibrary.org/obo/MP_0031128>)

# Class: <http://purl.obolibrary.org/obo/MP_0031130> (right-to-left shunt)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18299514") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031130> "a right-to-left shunt allows the deoxygenated, systemic venous return to bypass the lungs and return directly to the systemic arterial circulation; the oxygen content of the systemic arterial blood falls in proportion to the volume of systemic venous blood mixing with the normal pulmonary venous return; with reduced oxygen content, even with normal cardiac output, tissue oxygen delivery falls and the work capacity of muscles is limited")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031130> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031130> "2020-09-11T06:59:53Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031130> "R-L shunt")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031130> "right-to-left shunting")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031130> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031130> "MP:0031130")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031130> "right-to-left shunt")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031130> <http://purl.obolibrary.org/obo/MP_0031128>)

# Class: <http://purl.obolibrary.org/obo/MP_0031131> (myocardial fiber disarray)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15657260") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7890275") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.15420/ecr.2010.6.2.88") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031131> "loss of the normal parallel alignment of cardiac myocytes, whereby adjacent myocytes are arranged obliquely or perpendicularly to each other around foci of interstitial collagen (plexiform fibrosis) in a pinwheel or herringbone pattern; disarray is characterized by regions of architectural disorganization of hypertrophied myocytes and distinct nuclear changes")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031131> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031131> "2020-09-11T08:39:34Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/MP_0031131> "myocardial disarray")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031131> "adult cardiomyocyte disarray")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031131> "cardiac myocyte disarray")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031131> "myocardial cell disarray")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031131> "myocardial fibre disarray")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031131> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031131> "MP:0031131")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.15420/ecr.2010.6.2.88") rdfs:comment <http://purl.obolibrary.org/obo/MP_0031131> "Myocardial fiber disarray is not specific for hypertrophic cardiomyopathy (HCM); this architectural disorganization of cardiac myocytes has been found, although to a lesser extent, in dilated cardiomyopathy (CM), alcoholic CM, various congenital heart diseases and cardiovascular diseases (systemic hypertension, coronary artery disease and cor pulmonale) and in normal hearts")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031131> "myocardial fiber disarray")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0031131> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000937> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/CL_0000746>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031131> <http://purl.obolibrary.org/obo/MP_0000278>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031131> <http://purl.obolibrary.org/obo/MP_0002190>)


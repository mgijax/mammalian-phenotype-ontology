AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004757> "abnormal distal convoluted tubule morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0004757> <http://purl.obolibrary.org/obo/MP_0002703>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030145> "abnormal digastric muscle anterior belly morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030145> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030145> "MP:0030145")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030145> "abnormal digastric anterior belly morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030145> <http://purl.obolibrary.org/obo/MP_0013815>)

# Class: <http://purl.obolibrary.org/obo/MP_0030146> (abnormal digastric posterior belly morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030146> "any structural anomaly of the longer, posterior belly of the digastric muscle arising from the mastoid notch which is on the inferior surface of the skull, medial to the mastoid process of the temporal bone; the posterior belly is supplied by the digastric branch of facial nerve")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030146> <https://orcid.org/0000-0002-6490-7723>)

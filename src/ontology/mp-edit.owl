# Class: <http://purl.obolibrary.org/obo/MP_0031720> (ventricular flutter)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0011841") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1002/9781119066446.ch16") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/ventricular-flutter-ecg-library/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031720> "a life-threatening, hemodynamically unstable ventricular tachycardia characterized by an extremely rapid heart rate and a smooth, undulating sine-wave pattern with regular, large oscillations")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031720> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4266>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031720> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031720> "2026-04-20T07:25:09Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031720> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031720> "MP:0031720")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031720> "Ventricular flutter is a severe form of rapid monomorphic ventricular tachycardia with no distinguishable QRS, P, or T waves that almost always degenerates rapidly into ventricular fibrillation. Do not confuse the two terms. Ventricular flutter is a macroreentrant prefibrillatory rhythm that presents as a smooth, undulating sine-wave pattern with the ECG often looking identical when viewed upside down. Ventricular fibrillation is characterized by a chaotic, irregular waveform with deflections of varying morphology and amplitude and represents a state of complete electrical disorganization, where the ventricles quiver instead of contracting synchronously, resulting in total loss of cardiac output.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031720> "ventricular flutter")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031720> <http://purl.obolibrary.org/obo/MP_0031711>)

# Class: <http://purl.obolibrary.org/obo/MP_0031721> (abnormal J wave)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0012272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15842434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21499517") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/osborn-wave-j-wave-ecg-library/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.droracle.ai/articles/621094/what-is-the-significance-of-an-osborn-wave-j") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031721> "any anomaly in the positive convex deflection that occurs at the junction of the QRS complex and ST segment, the J-point")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031721> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4261>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031721> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031721> "2026-04-20T12:07:14Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031721> "abnormal Osborn wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031721> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031721> "MP:0031721")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031721> "The J wave is a deflection with a dome or hump morphology that appears on the ECG after the QRS complex or as a small secondary R wave (R'). J waves are commonly associated with hypothermia but also seen in other conditions, including myocardial ischemia, hypercalcemia, brain injury, and sepsis. Their most critical implication is their arrhythmogenic potential, particularly as precursors to malignant ventricular arrhythmias including ventricular fibrillation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031721> "abnormal J wave")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031721> <http://purl.obolibrary.org/obo/MP_0010508>)

# Class: <http://purl.obolibrary.org/obo/MP_0031722> (abnormal podosome morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0002102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30594495") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31836688") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031722> "any structural anomaly of the actin-rich adhesion structure characterized by formation upon cell substrate contact and localization at the substrate-attached part of the cell; podosomes present as micron-sized F-actin cores surrounded by an adhesive ring of integrins and integrin–actin linkers, such as talin and vinculin")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031722> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4238>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031722> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031722> "2026-04-20T13:04:50Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031722> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031722> "MP:0031722")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031722> "Podosomes are dynamic adhesion structures formed constitutively by macrophages, dendritic cells and osteoclasts and transiently in a wide variety of cells, such as endothelial cells and megakaryocytes. They mediate numerous functions, including cell-matrix adhesion, extracellular matrix degradation, mechanosensing and cell migration.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031722> "abnormal podosome morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031722> <http://purl.obolibrary.org/obo/MP_0020849>)

# Class: <http://purl.obolibrary.org/obo/MP_0031723> (abnormal podosome assembly)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0071800") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41521804") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031723> "any anomaly in the aggregation, arrangement and/or bonding together of a set of components to form a podosome")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031723> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4238>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031723> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031723> "2026-04-20T13:12:42Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031723> "abnormal podosome formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031723> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031723> "MP:0031723")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031723> "Podosomes, actin-rich protrusions on the cell membrane, act as adhesion sites between the actin skeleton and the extracellular matrix, constantly assembling and disassembling. The specific microenvironment shapes the dynamic behavior of these structures, with actin-myosin contractility and microtubules acting as key regulators of their assembly and turnover.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031723> "abnormal podosome assembly")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031723> <http://purl.obolibrary.org/obo/MP_0031725>)


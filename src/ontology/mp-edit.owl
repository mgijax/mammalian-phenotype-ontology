AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031105> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031105> "MP:0031105")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031105> "rhonchi")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031105> <http://purl.obolibrary.org/obo/MP_0001950>)


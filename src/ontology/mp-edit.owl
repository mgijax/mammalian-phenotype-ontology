# Class: <http://purl.obolibrary.org/obo/MP_0031123> (abnormal anterior longitudinal ligament morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.kenhub.com/en/library/anatomy/joints-and-ligaments-of-the-vertebral-column") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031123> "any structural anomaly of the strong, broad fibrous band that covers and connects the anterolateral aspects of the vertebral bodies and intervertebral (IV) discs; this ligament extends from the pelvic surface of the sacrum to the anterior tubercle of vertebra C1 (atlas) and the occipital bone anterior to the foramen magnum; it prevents hyperflexion of the vertebral column, maintaining stability of the joints between the vertebral bodies; it is the only ligament that limits extension; all other ligaments of the vertebral column, like the IV ligaments, limit forms of flexion")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031123> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031123> "2020-08-25T14:01:06Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031123> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031123> "MP:0031123")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031123> "abnormal anterior longitudinal ligament morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031123> <http://purl.obolibrary.org/obo/MP_0004703>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031123> <http://purl.obolibrary.org/obo/MP_0005504>)

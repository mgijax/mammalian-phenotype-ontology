AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031565> "MP:0031565")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031565> "Failure to close the interventricular foramen leads to an interventricular septal defect known as a patent interventricular foramen.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031565> "abnormal heart interventricular foramen morphology")

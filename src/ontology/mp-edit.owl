AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030549> "MP:0030549")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030549> "abnormal cementocyte lacunocanalicular system morphology")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0025337") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://medlineplus.gov/ency/article/003031.htm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031347> "a condition where the white part of the eye (sclera) appears reddened or bloodshot, ranging from a few enlarged blood vessels appearing as wiggly lines over the sclera to a bright red color completely covering to sclera")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031347> "2022-02-01T09:42:52Z"^^xsd:dateTime)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031347> <https://orcid.org/0000-0002-6490-7723>)

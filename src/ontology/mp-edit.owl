AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0030856> "abnormal ulnar process morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030856> "MP:0030856")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030856> "abnormal olecranon morphology")

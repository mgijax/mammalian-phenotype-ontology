# Class: <http://purl.obolibrary.org/obo/MP_0030875> (abnormal cartilaginous joint morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://opentextbc.ca/anatomyandphysiology/chapter/9-3-cartilaginous-joints/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://teachmeanatomy.info/the-basics/joints-basic/classification-of-joints/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030875> "any structural anomaly of any joint that lacks a joint cavity and involves bones that are joined together by either hyaline cartilage or fibrocartilage; there are two main types: synchondroses (or primary cartilaginous joints) where the bones are united by hyaline cartilage, and symphyses (or secondary cartilaginous joints) where the bones are united by a layer of fibrocartilage")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030875> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030875> "2018-10-17T11:32:38Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030875> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030875> "MP:0030875")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030875> "abnormal cartilaginous joint morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030875> <http://purl.obolibrary.org/obo/MP_0002932>)

# Class: <http://purl.obolibrary.org/obo/MP_0030876> (abnormal costochondral joint morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0002293") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.kenhub.com/en/library/anatomy/thoracic-cage") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030876> "any structural anomaly of the hyaline cartilaginous joint (synchondrosis) between each rib and its costal cartilage; the articulation is between the cup-shaped depression in the sternal end of a rib and the lateral end of a costal cartilage; the rib and its cartilage are firmly bound together by the continuity of the periosteum of the rib with the perichondrium of the cartilage; no movement normally occurs at these joints")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030876> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030876> "2018-10-17T11:59:45Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030876> "abnormal chondrocostal synchondrosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030876> "abnormal costo-chondral junction morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030876> "abnormal costochondral junction morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030876> "abnormal costochondral synchondrosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030876> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030876> "MP:0030876")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030876> "abnormal costochondral joint morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030876> <http://purl.obolibrary.org/obo/MP_0004053>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030876> <http://purl.obolibrary.org/obo/MP_0004625>)

# Class: <http://purl.obolibrary.org/obo/MP_0030877> (abnormal symphysis morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0002216") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Symphysis") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030877> "any structural anomaly of any cartilaginous joint in which the articulating bones or cartilages are connected by fibrocartilage; a symphysis is a slightly movable joint (amphiarthrosis)")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030877> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030877> "2018-10-17T12:20:07Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030877> "abnormal secondary cartilaginous joint morphology")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030784> "MP:0030784")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030784> "abnormal iliofemoral ligament morphology")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0012532> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0012532> "MP:0012532")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012532> "abnormal surface ectoderm morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012532> <http://purl.obolibrary.org/obo/MP_0014139>)


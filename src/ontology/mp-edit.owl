AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030787> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030787> "MP:0030787")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030787> "abnormal cranial suspensory ligament morphology")

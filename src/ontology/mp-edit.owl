AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031108> "MP:0031108")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031108> "increased circulating myoglobin level")

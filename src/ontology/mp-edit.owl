# Class: <http://purl.obolibrary.org/obo/MP_0010975> (abnormal lung lobe morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0010975> "any structural anomaly of any of the anatomically and functionally distinct subunits (lobes) comprising the left or right lung, where each lobe receives air from its own secondary bronchus and is separated from it neighbors by one or more fissures (walls of connective tissue)")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0010975> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0010975> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0010975> "2011-03-24T03:38:48Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0010975> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010975> "MP:0010975")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0010975> "The human right lung is divided into three lobes as opposed to two lobes on the left, while the mouse right lung consists of four lobes as opposed to a single lobe on the left.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010975> "abnormal lung lobe morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010975> <http://purl.obolibrary.org/obo/MP_0001175>)


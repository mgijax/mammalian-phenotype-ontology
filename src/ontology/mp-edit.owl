AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030507> "abnormal dental papilla morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030507> <http://purl.obolibrary.org/obo/MP_0000116>)


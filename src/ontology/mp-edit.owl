# Class: <http://purl.obolibrary.org/obo/MP_0013554> (abnormal apocrine gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0123813611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Apocrine") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013554> "any structural anomaly of any exocrine gland whose cells bud their secretions off through the plasma membrane producing membrane-bound vesicles in the lumen; the apical portion of the secretory cell of the gland pinches off and enters the lumen; it loses part of its cytoplasm in their secretions; apocrine secretion is functional during hormonal stress or puberty; an example of true apocrine glands are mammary glands, responsible for secreting breast milk")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013554> "MP:0013554")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013554> "abnormal apocrine gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013554> <http://purl.obolibrary.org/obo/MP_0013558>)

# Class: <http://purl.obolibrary.org/obo/MP_0013555> (abnormal apocrine gland physiology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0123813611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Apocrine") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013555> "any functional anomaly of any exocrine gland whose cells bud their secretions off through the plasma membrane producing membrane-bound vesicles in the lumen; the apical portion of the secretory cell of the gland pinches off and enters the lumen; it loses part of its cytoplasm in their secretions; apocrine secretion is functional during hormonal stress or puberty; an example of true apocrine glands are mammary glands, responsible for secreting breast milk")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013555> "MP:0013555")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013555> "abnormal apocrine gland physiology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013555> <http://purl.obolibrary.org/obo/MP_0013559>)

# Class: <http://purl.obolibrary.org/obo/MP_0013556> (abnormal holocrine gland physiology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Holocrine") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://medical-dictionary.thefreedictionary.com/holocrine+gland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013556> "any functional anomaly of any exocrine gland whose secretion consists of its own disintegrated secretory cells along with its secretory product; holocrine secretions are produced in the cytoplasm of the cell and released by the rupture of the plasma membrane, which destroys the cell and results in the secretion of the product into the lumen")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013556> "MP:0013556")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013556> "abnormal holocrine gland physiology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013556> <http://purl.obolibrary.org/obo/MP_0013559>)

# Class: <http://purl.obolibrary.org/obo/MP_0013557> (abnormal merocrine gland physiology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Merocrine") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013557> "any functional anomaly of any exocrine gland whose secretions are excreted via exocytosis from secretory cells into an epithelial-walled duct or ducts and thence onto a bodily surface or into the lumen; the gland releases its product and no part of the gland is lost or damaged")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013557> "abnormal eccrine gland physiology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013557> "MP:0013557")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013557> "abnormal merocrine gland physiology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013557> <http://purl.obolibrary.org/obo/MP_0013559>)

# Class: <http://purl.obolibrary.org/obo/MP_0013558> (abnormal exocrine gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Exocrine_gland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013558> "any structural anomaly of any of the glands of the exocrine system that secrete their essential product by way of a duct to some environment external to itself, either inside the body or on a surface of the body; the duct portion may be branched (compound) or unbranched (simple); the glandular portion may be tubular or acinar, or may be a mix of the two (tubuloacinar or tubuloalveolar); if the glandular portion branches, then the gland is called a branched gland Typical exocrine glands include sweat glands, salivary glands, mammary glands, stomach, liver, pancreas")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013558> "abnormal duct gland morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013558> "abnormal ducted gland morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0013558> "abnormal glandula exocrine morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013558> "MP:0013558")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013558> "abnormal exocrine gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013558> <http://purl.obolibrary.org/obo/MP_0002163>)

# Class: <http://purl.obolibrary.org/obo/MP_0013559> (abnormal exocrine gland physiology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Exocrine_gland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013559> "any functional anomaly of any of the glands of the exocrine system that secrete their essential product by way of a duct to some environment external to itself, either inside the body or on a surface of the body; the duct portion may be branched (compound) or unbranched (simple); the glandular portion may be tubular or acinar, or may be a mix of the two (tubuloacinar or tubuloalveolar); if the glandular portion branches, then the gland is called a branched gland Typical exocrine glands include sweat glands, salivary glands, mammary glands, stomach, liver, pancreas")

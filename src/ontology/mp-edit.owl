# Class: <http://purl.obolibrary.org/obo/MP_0010089> (abnormal circulating creatine kinase level)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-3691-0324>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0010089> "any anomaly in the concentration in the blood of an enzyme that catalyzes the reversible transfer of creatine to phosphocreatine")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0010089> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0010089> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0010089> "2010-03-29T12:56:17Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010089> "abnormal circulating CK level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010089> "abnormal circulating CPK level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010089> "abnormal circulating creatine phosphokinase level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010089> "abnormal circulating creatinine kinase level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0010089> "abnormal circulating phospho-creatine kinase level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0010089> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010089> "MP:0010089")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0010089> "There is ambiguity in the literature regarding the terms creatinine kinase and creatine kinase. Most resources insist that creatine kinase is correct. See PMID:17174558 and PMID:14624200 not to mention Wikipedia.  Creatine kinase is an enzyme found in the heart, brain, skeletal muscle, and other tissues. Increased amounts of CK are released into the blood when there is muscle damage. The small amount of CK that is normally in the blood comes primarily from skeletal muscles.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010089> "abnormal circulating creatine kinase level")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0010089> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0002185> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000178>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

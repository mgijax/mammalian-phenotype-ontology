AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004581> "abnormal cochlear hair bundle ankle links morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0004581> <http://purl.obolibrary.org/obo/MP_0004577>)


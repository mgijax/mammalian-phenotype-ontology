AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030841> "abnormal transverse acetabular ligament morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030841> <http://purl.obolibrary.org/obo/MP_0030829>)


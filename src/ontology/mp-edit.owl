# Class: <http://purl.obolibrary.org/obo/MP_0000627> (abnormal mammary gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0-683-40008-8") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0000627> "any structural anomaly of the compound, alveolar and apocrine accessory gland of the skin of mammals that secretes milk")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal glandula mammaria morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal lactiferous gland morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal mammary glands")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "mammary gland dysplasia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0000627> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal Brustdruese morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal dug morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal lobe of mammary gland morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal mamma morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0000627> "abnormal mammae morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0000627> "MP:0000627")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0000627> "The neonatal male and female rat and mouse have 6 and 5 pairs of glands, respectively, with a single, central lactiferous duct, several branching secondary ducts, and numerous tertiary ducts (Ceriani 1970; Cardiff and Wellings 1999). In the rat, the glands are distributed in pairs along the milk line, with 1 pair cervical, 2 thoracic, 1 abdominal, and 2 inguinal (Astwood, Geschickter, and Rausch 1937). Distribution in the mouse is in the neck, chest wall (2 pairs), abdominal wall, and inguinal region (Cardiff and Wellings 1999).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0000627> "abnormal mammary gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0000627> <http://purl.obolibrary.org/obo/MP_0010678>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0000627> <http://purl.obolibrary.org/obo/MP_0013554>)


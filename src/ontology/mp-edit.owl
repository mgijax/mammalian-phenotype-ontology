# Class: <http://purl.obolibrary.org/obo/MP_0004578> (abnormal cochlear hair bundle tip links morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0004578> "any structural anomaly in single, three-stranded interrow filaments that extend obliquely from the tip of one stereocilium to the lateral side of an adjacent taller stereocilium; in the mouse, tip links are already detectable prenatally and persist throughout life; tips links are thought to gate the mechanotransducer channel, are lost from the cell surface after exposure to either calcium chelator BAPTA or lanthanum, and resist degradation by the protease subtilisin")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0004578> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0004578> "MP:0004578")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004578> "abnormal cochlear hair bundle tip links morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0004578> <http://purl.obolibrary.org/obo/MP_0004577>)

# Class: <http://purl.obolibrary.org/obo/MP_0004579> (abnormal cochlear hair bundle horizontal top connectors morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0004579> "any structural anomaly in the inter-stereocilial links that connect the top of a shorter stereocilium to an adjacent longer stereocilium at a short distance below the tip links; the appearance of horizontal top connectors, which persist into adulthood, occurs concomitant with this loss of ankle links; top connectors are essentially unaffected by treatment with subtilisin and EGTA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0004579> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0004579> "MP:0004579")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0004579> "abnormal cochlear hair bundle horizontal top connectors morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0004579> <http://purl.obolibrary.org/obo/MP_0004577>)

# Class: <http://purl.obolibrary.org/obo/MP_0004580> (abnormal cochlear hair bundle transient lateral links morphology)


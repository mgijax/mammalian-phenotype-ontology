AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MESH:A11.118.637.555.567.569.220") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0005010> "any structural anomaly of the regulatory subset of T lymphocytes that are involved in MHC class I restricted interactions")

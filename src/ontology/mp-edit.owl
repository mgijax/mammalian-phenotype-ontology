AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0011841> "abnormal urethral crest of male")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0011841> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0011841> "MP:0011841")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0011841> "abnormal male urethral crest morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011841> <http://purl.obolibrary.org/obo/MP_0011776>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011841> <http://purl.obolibrary.org/obo/MP_0011840>)


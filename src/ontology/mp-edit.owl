AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0008750> "abnormal interferon level")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0008750> <http://purl.obolibrary.org/obo/MP_0008713>)


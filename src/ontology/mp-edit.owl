# Class: <http://purl.obolibrary.org/obo/MP_0031373> (abnormal manchette perinuclear ring morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22366765") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33144677") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031373> "any structural morphology of the ring-like portion of the manchette that surrounds the base of the elongating spermatid nucleus below the acroplaxome marginal ring and plays a key role in shaping the nucleus and the sperm head; microtubules extend from the perinuclear ring into the cytoplasm and/or basal body of the spermatid")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031373> "2022-03-14T12:21:08Z"^^xsd:dateTime)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031373> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031373> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031373> "MP:0031373")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33144677") rdfs:comment <http://purl.obolibrary.org/obo/MP_0031373> "Although the perinuclear ring is regarded as the microtubule-organizing center for the manchette, findings about the nucleation site and the direction of microtubules are inconsistent. During spermatid differentiation, the manchette moves toward the tail neck region, with constriction of the perinuclear ring, which contributes to sculpting of the sperm head in mice.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031373> "abnormal manchette perinuclear ring morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031373> <http://purl.obolibrary.org/obo/MP_0009376>)


AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030184> "abnormal zygomaticus muscle morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030184> <http://purl.obolibrary.org/obo/MP_0030039>)

# Class: <http://purl.obolibrary.org/obo/MP_0030555> (abnormal cementocyte lacuna morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26274352") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27029548") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030555> "any structural anomaly of the small cavity within the cellular cementum that is occupied by a cementocyte cell body; cementocyte lacunae are described as larger and more irregular in size and shape (from oval to tubular) and with rougher walls than the typical ellipsoid osteocyte lacunae; occasionally, empty lacunae or lacunae containing more than one cell are observed in cellular cementum, not typically observed in osteocyte lacunae")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030555> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030555> "2018-01-19T17:02:33Z"^^xsd:dateTime)

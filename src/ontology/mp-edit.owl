# Class: <http://purl.obolibrary.org/obo/MP_0030542> (abnormal dentin development)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0097187") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Dentin") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030542> "any anomaly in the process whose specific outcome is the formation of dentin, the hard portion of the tooth surrounding the pulp, covered by enamel on the crown and cementum on the root; dentinogenesis begins prior to enamel formation and is initiated by the odontoblasts of the dental pulp; dentin is derived from the dental papilla of the tooth germ; after apposition of predentin and maturation into dentin, the cell bodies of the odontoblasts remain in the pulp inside the tooth, along its outer wall; unlike enamel, dentin continues to form throughout life and can be initiated in response to stimuli, such as tooth decay or attrition")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030542> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030542> "2018-01-19T13:47:52Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030542> "abnormal dentin formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030542> "abnormal dentine development")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030542> "abnormal dentine formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030542> "abnormal dentinogenesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030542> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030542> "MP:0030542")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030542> "abnormal dentin development")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0030542> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/GO_0097187>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

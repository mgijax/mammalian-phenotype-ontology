# Class: <http://purl.obolibrary.org/obo/MP_0031512> (abnormal circulating C-peptide level)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0030794") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30252282") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031512> "anomaly in the amount in the blood of the connecting (C) peptide that links the A and B chains in proinsulin")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031512> "2023-11-13T16:45:27Z"^^xsd:dateTime)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031512> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031512> "abnormal blood C-peptide level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031512> "abnormal circulating connecting peptide level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MP_0031512> "abnormal plasma C-peptide level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MP_0031512> "abnormal serum C-peptide level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031512> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031512> "MP:0031512")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031512> "C-peptide provides a means to promote the efficient folding and assembly of the A and B chains of proinsulin in the endoplasmic reticulum during insulin biosynthesis; after cleavage of proinsulin, C-peptide is stored with insulin in the soluble phase of the secretory granules and is subsequently released in equimolar amounts with insulin, providing an independent indicator of insulin secretion.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031512> "abnormal circulating C-peptide level")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031512> <http://purl.obolibrary.org/obo/MP_0005416>)


# Class: <http://purl.obolibrary.org/obo/MP_0031745> (T wave inversion)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0010872") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ekgecho.de/the-t-wave-physiology-variants-and-ecg-features/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/t-wave-ecg-library/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031745> "a downward (negative) deflection of the T wave in ECG leads where it is typically upright; the T-wave is considered negative if its terminal portion is below the isoelectric baseline, regardless of whether its other parts are above the baseline")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000233> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4304>) <http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031745> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4274>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031745> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031745> "2026-06-03T11:43:23Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031745> "T-wave inversion")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031745> "TWI")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031745> "inverted T wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031745> "inverted T waves")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031745> "inverted T-wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031745> "negative T wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031745> "negative T-wave")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031745> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031745> "MP:0031745")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031745> "Normal repolarization of the ventricles typically produces upright T waves in most leads. While isolated T-wave inversions (TWIs) can be normal, particularly in specific leads, the presence of TWI in two or more anatomically contiguous leads is generally considered pathological. Any new T-wave inversion compared with prior ECGs is deemed abnormal.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031745> "T wave inversion")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031745> <http://purl.obolibrary.org/obo/MP_0010505>)


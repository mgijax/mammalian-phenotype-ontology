# Class: <http://purl.obolibrary.org/obo/MP_0031729> (atrial flutter)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0004749") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11884328") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/atrial-flutter-ecg-library/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.protrainings.uk/courses/cpr-bls-ils-als-aed/ecg-awareness/videos/atrial-flutter-ecg") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031729> "a rapid, regular atrial rate caused by a macro-reentrant circuit, usually within the right atrium, that is characterized by a sawtooth pattern of atrial activity on an ECG; normal P waves are typically replaced by regular, undulating F-waves (flutter waves) that are continuous, without an isoelectric baseline")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031729> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4252>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0031729> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/MP_0031729> "2026-05-04T13:43:14Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031729> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031729> "MP:0031729")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0031729> "In atrial flutter, the ventricular rate is typically slower than the atrial rate due to the atrioventricular node's limitation of impulses to the ventricles, and may be regular or irregular depending on the atrial to ventricular conduction pattern. Unlike atrial flutter which presents a regular sawtooth pattern, atrial fibrillation shows no distinct P waves and is characterized by chaotic, erratic electrical impulses causing the atria to quiver.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031729> "atrial flutter")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031729> <http://purl.obolibrary.org/obo/MP_0031715>)

# Class: <http://purl.obolibrary.org/obo/MP_0031730> (atrial premature beat)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HP:0006699") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/premature-atrial-complex-pac/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK559204/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031730> "an extra heart beat originating from an ectopic focus within the atria, rather than the sinoatrial node, and characterized on ECG by an abnormal (non-sinus) P wave, usually followed by a normal QRS complex")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MP_0031730> <https://github.com/mgijax/mammalian-phenotype-ontology/issues/4252>)

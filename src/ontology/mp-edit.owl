AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0014133> "Withdrawn one day after initial request at submitter request")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0014133> "obsolete abnormal Pavlovian conditioned approach")

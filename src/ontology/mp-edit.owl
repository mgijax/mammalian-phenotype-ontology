# Class: <http://purl.obolibrary.org/obo/MP_0013752> (stridor)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Stridor") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013752> "a high-pitched breath sound resulting from turbulent air flow in the larynx or lower in the bronchial tree; it should not to be confused with stertor which is a noise originating in the pharynx; stridor is a physical sign which is caused by a narrowed or obstructed airway; it can be inspiratory, expiratory or biphasic, although it is usually heard during inspiration")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013752> "MP:0013752")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013752> "stridor")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013752> <http://purl.obolibrary.org/obo/MP_0001950>)

# Class: <http://purl.obolibrary.org/obo/MP_0013753> (tracheomalacia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0-683-40008-8") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Tracheomalacia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013753> "a condition characterized by flaccidity of the tracheal support cartilage which leads to tracheal collapse especially when increased airflow is demanded; the trachea normally dilates slightly during inspiration and narrows slightly during expiration; these processes are exaggerated in tracheomalacia, leading to airway collapse on expiration; the usual symptom of tracheomalacia is expiratory stridor or laryngeal crow")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013753> "MP:0013753")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013753> "tracheomalacia")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013753> <http://purl.obolibrary.org/obo/MP_0002133>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013753> <http://purl.obolibrary.org/obo/MP_0031306>)

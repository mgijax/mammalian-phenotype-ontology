# Class: <http://purl.obolibrary.org/obo/MP_0006110> (ventricular fibrillation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-4606-0597>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCBI:matt") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://litfl.com/ventricular-fibrillation-vf-ecg-library/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0006110> "asynchronous contraction or quivering of individual cardiac muscle fibers in the ventricles")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0006110> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0006110> "MP:0006110")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0006110> "Do not confuse with ventricular flutter, a macroreentrant prefibrillatory rhythm that presents as regular, smooth, large-amplitude sinusoidal waves (sine wave pattern), with the ECG often looking identical when viewed upside down. Ventricular fibrillation is characterized by a chaotic, irregular waveform with deflections of varying morphology and amplitude and represents a state of complete electrical disorganization, where the ventricles quiver instead of contracting synchronously, resulting in total loss of cardiac output.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0006110> "ventricular fibrillation")

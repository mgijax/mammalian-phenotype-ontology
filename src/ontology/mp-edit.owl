AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0006267> "abnormal intercalated disk morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0006267> <http://purl.obolibrary.org/obo/MP_0000278>)


AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013613> "abnormal volumetric bone mineral density")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013613> <http://purl.obolibrary.org/obo/MP_0010119>)


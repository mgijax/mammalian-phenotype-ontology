# Class: <http://purl.obolibrary.org/obo/MP_0030521> (abnormal cervical loop morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=0323290868") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://books.google.com/books?isbn=1455754099") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.stembook.org/node/551") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030521> "any structural anomaly of the most cervical part of an enamel organ where the inner enamel epithelium and the outer enamel epithelium merge in a loop, thus delineating the end of the anatomic crown and the site where root formation begins; to form the root region, the cervical loop begins to grow deeper into the surrounding ectomesenchyme of the dental sac, elongating and moving away from the newly completed crown area to enclose more of the dental papilla, forming Hertwig's epithelial root sheath (HERS)")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030521> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030521> "2018-01-03T12:00:30Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030521> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030521> "MP:0030521")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030521> "abnormal cervical loop morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030521> <http://purl.obolibrary.org/obo/MP_0030508>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030521> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0003843>)))

# Class: <http://purl.obolibrary.org/obo/MP_0030522> (abnormal stellate reticulum morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dental.pitt.edu/periohistology-glossary") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pocketdentistry.com/10-early-tooth-development-root-development-including-cementogenesis-and-tooth-eruption/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030522> "any structural anomaly of the network of star-shaped cells found in the core of the dental (enamel) organ between the stratum intermedium and outer enamel epithelium which secrete hydrophilic glycosaminoglycans into the extracellular compartment; the stellate reticulum is most fully developed at the bell stage when intercellular spaces become fluid-filled, presumably related to osmotic effects arising from the high concentration of glycosaminoglycans; the main function of the stellate reticulum is mechanical, protecting the underlying dental tissues against physical disturbance and maintaining tooth shape")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030522> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030522> "2018-01-03T12:17:21Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030522> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030522> "MP:0030522")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030522> "abnormal stellate reticulum morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030522> <http://purl.obolibrary.org/obo/MP_0030521>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030522> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0003843>)))

# Class: <http://purl.obolibrary.org/obo/MP_0030523> (abnormal stratum intermedium morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Stratum_intermedium") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pocketdentistry.com/10-early-tooth-development-root-development-including-cementogenesis-and-tooth-eruption/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030523> "any structural anomaly of the layer of two or three flattened cells located between the inner enamel epithelium and the newly forming cells of the stellate reticulum; it first appears during the early bell stage of tooth development, has a notably high alkaline phosphatase activity, and forms a part of the dental (enamel) organ; this layer, along with the inner enamel epithelium, is responsible for the tooth enamel formation")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030523> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030523> "2018-01-03T12:45:22Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030523> "abnormal dental stratum intermedium morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030523> "abnormal tooth stratum intermedium morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030523> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030523> "MP:0030523")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030523> "abnormal stratum intermedium morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030523> <http://purl.obolibrary.org/obo/MP_0010747>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030523> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0005176>)))


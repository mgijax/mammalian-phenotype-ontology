AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010630> "MP:0010630")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0010630> "Do not confuse cardiac muscle tissue with the myocardium. Myocardium consists primarily of cardiac muscle but these structures are not identical. Cardiac muscle tissue also exists outside the heart so this term has not been made a child of heart myocardial layer directly.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010630> "abnormal cardiac muscle tissue morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010630> <http://purl.obolibrary.org/obo/MP_0002108>)

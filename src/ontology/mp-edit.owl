AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0012525> "abnormal rhombic lip morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0012525> <http://purl.obolibrary.org/obo/MP_0000913>)


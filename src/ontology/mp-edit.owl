AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0011838> "abnormal navicular fossa of male urethra")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0011838> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0011838> "MP:0011838")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0011838> "abnormal navicular fossa morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011838> <http://purl.obolibrary.org/obo/MP_0011779>)


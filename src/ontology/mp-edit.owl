# Class: <http://purl.obolibrary.org/obo/MP_0031013> (abnormal egg activation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0007343") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-0-12-812571-7") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10091064") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1016/J.RBMO.2014.01.008") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031013> "any anomaly in the series of biochemical and morphological events that converts a metaphase-II-arrested oocyte into a fertilized egg ready to begin embryogenesis; in most mammals, oocyte activation is a spatial-temporal regulated process induced by sperm entry that involves early events such a transient rise in intracellular calcium concentration, cortical granule exocytosis and meiotic cell-cycle resumption, and later events such as pronuclear formation, translation of maternal mRNAs and meiosis-to-mitosis transition")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031013> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031013> "2020-01-07T11:22:13Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031013> "abnormal oocyte activation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031013> "abnormal ovum activation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031013> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031013> "MP:0031013")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031013> "abnormal egg activation")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0031013> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/GO_0007343>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031013> <http://purl.obolibrary.org/obo/MP_0005410>)

# Class: <http://purl.obolibrary.org/obo/MP_0031014> (polyspermy)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN-10:0-8153-4072-9") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16478602") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031014> "increased incidence of fertilized oocytes fused with two or more sperm due to reduced ability or inability to prevent fertilization by multiple sperm during the egg activation process; normally only a single sperm fuses with the egg plasma membrane and injects its nucleus and other organelles into the egg cytoplasm; if more than one sperm fuses, multipolar or extra mitotic spindles are formed, resulting in faulty segregation of chromosomes during cell division; nondiploid cells are produced, and development usually stops")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0031014> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031014> "2020-01-07T11:47:39Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031014> "polyspermic fertilization")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031014> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0031014> "failure of polyspermy block")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0031014> "failure of polyspermy prevention")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031014> "MP:0031014")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031014> "polyspermy")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0031014> <http://purl.obolibrary.org/obo/MP_0031013>)


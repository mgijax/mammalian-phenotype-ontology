AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0003449> "abnormal intestine goblet cell morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/MP_0003449> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000160> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/mpath#part_of> <http://purl.obolibrary.org/obo/UBERON_0000160>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

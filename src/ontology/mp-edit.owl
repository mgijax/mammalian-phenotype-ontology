# Class: <http://purl.obolibrary.org/obo/MP_0013709> (abnormal cervical mammary gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:1483269485") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22949413") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013709> "any structural anomaly of either of two mammary glands located in the cervical (i.e. neck) region, forward of the axial area of the forelimbs (mice have a single pair of cervical mammary glands)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013709> "MP:0013709")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0013709> "The neonatal male and female rat and mouse have 6 and 5 pairs of glands, respectively, with a single, central lactiferous duct, several branching secondary ducts, and numerous tertiary ducts (Ceriani 1970; Cardiff and Wellings 1999). In the rat, the glands are distributed in pairs along the milk line, with 1 pair cervical, 2 thoracic, 1 abdominal, and 2 inguinal (Astwood, Geschickter, and Rausch 1937). Distribution in the mouse is in the neck, chest wall (2 pairs), abdominal wall, and inguinal region (Cardiff and Wellings 1999).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013709> "abnormal cervical mammary gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013709> <http://purl.obolibrary.org/obo/MP_0000627>)

# Class: <http://purl.obolibrary.org/obo/MP_0013710> (abnormal abdominal mammary gland morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:1483269485") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22949413") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0013710> "any structural anomaly of either of the two mammary glands located in the abdominal wall (mice have a single pair of abdominal mammary glands)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0013710> "MP:0013710")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0013710> "The neonatal male and female rat and mouse have 6 and 5 pairs of glands, respectively, with a single, central lactiferous duct, several branching secondary ducts, and numerous tertiary ducts (Ceriani 1970; Cardiff and Wellings 1999). In the rat, the glands are distributed in pairs along the milk line, with 1 pair cervical, 2 thoracic, 1 abdominal, and 2 inguinal (Astwood, Geschickter, and Rausch 1937). Distribution in the mouse is in the neck, chest wall (2 pairs), abdominal wall, and inguinal region (Cardiff and Wellings 1999).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0013710> "abnormal abdominal mammary gland morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0013710> <http://purl.obolibrary.org/obo/MP_0000627>)

# Class: <http://purl.obolibrary.org/obo/MP_0013711> (abnormal inguinal mammary gland morphology)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030327> "MP:0030327")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030327> "temporomandibular joint ankylosis")

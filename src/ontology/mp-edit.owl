AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030837> "abnormal knee joint morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030837> <http://purl.obolibrary.org/obo/MP_0030804>)

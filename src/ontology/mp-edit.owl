AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0009515> "gastrointestinal stromal tumour")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0009515> "MP:0009515")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0009515> "increased gastrointestinal stromal tumor incidence")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0009515> <http://purl.obolibrary.org/obo/MP_0010279>)


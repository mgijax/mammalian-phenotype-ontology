# Class: <http://purl.obolibrary.org/obo/MP_0005625> (increased plasma anion gap)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "RGD:cur") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0005625> "greater than the normal interval between the sum of routinely measured cations minus the sum of the routinely measured anions in the blood; the anion gap = (Na+ + K+) - (Cl- + HCO3-) where Na- is sodium, K+ is potassium, Cl- is chloride, and HCO3- is bicarbonate; high anion gap is indicative of metabolic acidosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0005625> "high anion gap")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0005625> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0005625> "MP:0005625")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0005625> "increased plasma anion gap")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0005625> <http://purl.obolibrary.org/obo/MP_0005624>)

# Class: <http://purl.obolibrary.org/obo/MP_0005626> (decreased plasma anion gap)


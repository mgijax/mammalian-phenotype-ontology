AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/MP_0011837> "abnormal membrana cloacalis morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0011837> "MP:0011837")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0011837> "abnormal cloacal membrane morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011837> <http://purl.obolibrary.org/obo/MP_0010115>)

# Class: <http://purl.obolibrary.org/obo/MP_0011838> (abnormal navicular fossa morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0011838> "any structural anomaly of the dilated terminal portion of the male spongy urethra located in the glans penis right before the external urethral orifice, also referred to as the most distal pendulous urethra; it is lined by stratified squamous, non-keratinizing epithelium; during development, the glans of the penis is initially solid but cannulates to give rise to the navicular fossa")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0011838> <https://orcid.org/0000-0003-3691-0324>)

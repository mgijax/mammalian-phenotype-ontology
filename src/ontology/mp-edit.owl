AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MP_0000864> "cerebellum vermis dysplasia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0000864> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0000864> "MP:0000864")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0000864> "abnormal cerebellum vermis morphology")

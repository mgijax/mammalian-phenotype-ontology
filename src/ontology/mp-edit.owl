# Class: <http://purl.obolibrary.org/obo/MP_0031565> (abnormal heart interventricular foramen morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0013152") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://discovery.lifemapsc.com/library/review-of-medical-embryology/chapter-120-septation-of-ventricles-truncus-arteriosus-and-conus-cordis") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ebook.sts.org/sts/view/Cardiac-and-Congenital/1864080/all/Ventricular_Septal_Defects__VSD") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://embryology.med.unsw.edu.au/embryology/index.php?title=Intermediate_-_Atrial_Ventricular_Septation") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.sagepub.com/doi/pdf/10.1177/87564790122250507") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0031565> "any structural anomaly of the temporary opening (space) between the free rim of the muscular interventricular septum and the fused endocardial cushions, allowing for communication between the developing right and left heart ventricles; in normal development, the interventricular foramen closes off when the septum fuses with the endocardial cushions and bulbar ridges to form the membranous part of the interventricular septum")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0031565> "2024-01-09T11:31:14Z"^^xsd:dateTime)

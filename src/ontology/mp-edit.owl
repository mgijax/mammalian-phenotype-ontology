# Class: <http://purl.obolibrary.org/obo/MP_0011856> (abnormal glomerular filtration barrier function)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6490-7723>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMCID:PMC2895306") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0011856> "anomaly in the function of the highly specialized blood filtration interface that displays a high conductance to small and midsized solutes in plasma but retains relative impermeability to macromolecules; its integrity is maintained by physicochemical and signalling interplay among its three core constituents -- the fenestrated endothelium of the glomerular capillaries, the glomerular basement membrane, and the filtration slits of the visceral epithelial cell (podocyte); the barrier permits the passage of water, ions, and small molecules from the bloodstream into the Bowman's space and prevents the loss of large and/or negatively charged proteins (e.g. serum albumin) from blood into urine")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0011856> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0011856> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0011856> "2012-12-17T04:12:41Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0011856> "abnormal GFB permeability")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0011856> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0011856> "MP:0011856")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0011856> "abnormal glomerular filtration barrier function")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0011856> <http://purl.obolibrary.org/obo/MP_0013284>)


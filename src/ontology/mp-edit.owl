AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0031113> "lung parenchymal consolidation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0031113> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0031113> "MP:0031113")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0031113> "pulmonary parenchymal consolidation")

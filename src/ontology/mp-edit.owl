AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0009196> "Ghrelin-secreting cells are found mainly in the stomach and duodenum, but also in the jejunum, lungs, pancreatic islets, gonads, adrenal cortex, placenta, kidney and brain.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0009196> "abnormal pancreatic ghrelin secretion")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23960302") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.skullbaseinstitute.com/craniosynostosis-craniofacial/trigonocephaly.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030367> "early closure of the metopic suture of the skull; premature closure of this suture compromises the transverse growth of both the frontal bones and can cause a narrow, triangular shaped forehead (trigonocephaly) that is associated with orbital hypotelorism")

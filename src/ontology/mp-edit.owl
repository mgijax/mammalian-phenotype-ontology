# Class: <http://purl.obolibrary.org/obo/MP_0030545> (abnormal acellular cementum morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27029548") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.7med-pdf.com/1020q/13530-structure-of-cementum.html") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Cementum") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0030545> "any structural anomaly of the acellular layer of cementum, a living tissue that does not incorporate cells (cementocytes) into its structure, consisting only of extracellular matrix components and mineral; acellular cementum is the first cementum deposited on the dentin of the forming root, and is predominantly found on the cervical/coronal portion of the tooth root; it anchors the primary collagen fibers of the periodontal ligament, providing a strong attachment between the tooth and surrounding alveolar bone")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/MP_0030545> <https://orcid.org/0000-0002-6490-7723>)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MP_0030545> "2018-01-19T14:53:32Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030545> "abnormal acellular extrinsic fiber cementum morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MP_0030545> "abnormal primary cementum morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0030545> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0030545> "MP:0030545")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0030545> "abnormal acellular cementum morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030545> <http://purl.obolibrary.org/obo/MP_0003933>)
SubClassOf(<http://purl.obolibrary.org/obo/MP_0030545> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001753>)))


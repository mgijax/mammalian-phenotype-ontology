# Class: <http://purl.obolibrary.org/obo/MP_0010245> (abnormal spleen perifollicular zone morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11485909") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9415041") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MP_0010245> "any structural anomaly of the compartment located between the marginal zone and the red pulp harboring scattered B and T lymphocytes")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/MP_0010245> <https://orcid.org/0000-0003-3691-0324>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/MP_0010245> "csmith")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/MP_0010245> "2010-07-29T01:22:05Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MP_0010245> "MPheno.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MP_0010245> "MP:0010245")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MP_0010245> "Note that there is no consensus in the literature about whether the perifollicular zone (which does not exist in rodents) is part of the splenic red or white pulp. Notable differences in the structure of the spleen exist between humans and rodents. In this ontology, the marginal sinus (which doen not exist in human) has been included as part of the white pulp and may be the rodent functional equivalent of the human perifollicular zone.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MP_0010245> "abnormal spleen perifollicular zone morphology")
SubClassOf(<http://purl.obolibrary.org/obo/MP_0010245> <http://purl.obolibrary.org/obo/MP_0000689>)


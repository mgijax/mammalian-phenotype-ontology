AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0005652> "GO:0005652")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005652> "nuclear lamina")

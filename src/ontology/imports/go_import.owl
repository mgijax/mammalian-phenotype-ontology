AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0032994> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0032994> "GO:0032994")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0032994> "Macromolecular complexes in which the lipid component is all covalently bound to protein are not considered protein-lipid complexes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0032994> "protein-lipid complex")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0032994> <http://purl.obolibrary.org/obo/GO_0032991>)


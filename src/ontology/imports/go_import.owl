SubClassOf(<http://purl.obolibrary.org/obo/GO_0005652> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0005635>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005652> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0034399>))


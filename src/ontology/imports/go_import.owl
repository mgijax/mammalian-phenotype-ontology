AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0006310> <http://purl.obolibrary.org/obo/go#goslim_prokaryote>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0006310> <http://purl.obolibrary.org/obo/go#goslim_yeast>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006310> "DNA recombination")

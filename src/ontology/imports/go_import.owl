AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cilia") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0716731363") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0097650> "An incomplete microtubule containing 10 protofilaments that fuses with a complete microtubule called A tubule (containing 13 protofilaments) to form an axonemal outer doublet.")

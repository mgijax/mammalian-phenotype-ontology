AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0001508> "GO:0001508")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0001508> "Action potentials typically propagate across excitable membranes. This class covers both action potentials that propagate and those that fail to do so.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0001508> "action potential")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0001508> <http://purl.obolibrary.org/obo/GO_0042391>)


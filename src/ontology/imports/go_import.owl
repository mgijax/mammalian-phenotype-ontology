AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0007165> "GO:0007165")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0007165> <http://purl.obolibrary.org/obo/go#goslim_candida>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0007165> <http://purl.obolibrary.org/obo/go#goslim_chembl>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0007165> <http://purl.obolibrary.org/obo/go#goslim_metagenomics>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0007165> <http://purl.obolibrary.org/obo/go#goslim_plant>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0007165> <http://purl.obolibrary.org/obo/go#goslim_plant_ribbon>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0007165> "Note that signal transduction is defined broadly to include a ligand interacting with a receptor, downstream signaling steps and a response being triggered. A change in form of the signal in every step is not necessary. Note that in many cases the end of this process is regulation of the initiation of transcription. Note that specific transcription factors may be annotated to this term, but core/general transcription machinery such as RNA polymerase should not.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0007165> "signal transduction")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0007165> <http://purl.obolibrary.org/obo/GO_0009987>)

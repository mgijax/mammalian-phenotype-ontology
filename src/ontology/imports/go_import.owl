# Class: <http://purl.obolibrary.org/obo/GO_0097190> (apoptotic signaling pathway)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mtg_apoptosis") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0097190> "The series of molecular signals which triggers the apoptotic death of a cell. The pathway starts with reception of a signal, and ends when the execution phase of apoptosis is triggered.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/GO_0097190> "pr")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/GO_0097190> "2011-11-23T09:30:23Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0097190> "GO:0008624")
AnnotationAssertion(Annotation(rdfs:label "Activation of caspases through apoptosome-mediated cleavage") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0097190> "Reactome:R-HSA-111459")
AnnotationAssertion(Annotation(rdfs:label "Ceramide signalling") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0097190> "Reactome:R-HSA-193681")
AnnotationAssertion(Annotation(rdfs:label "Cell death signalling via NRAGE, NRIF and NADE") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0097190> "Reactome:R-HSA-204998")
AnnotationAssertion(Annotation(rdfs:label "FasL/ CD95L signaling") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0097190> "Reactome:R-HSA-75157")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0097190> "apoptotic signalling pathway")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0097190> "induction of apoptosis by extracellular signals")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0097190> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0097190> "GO:0097190")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0097190> "This term can be used to annotate gene products involved in apoptotic events happening downstream of the cross-talk point between the extrinsic and intrinsic apoptotic pathways. The cross-talk starts when caspase-8 cleaves Bid and truncated Bid interacts with mitochondria. From this point on it is not possible to distinguish between extrinsic and intrinsic pathways.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0097190> "apoptotic signaling pathway")

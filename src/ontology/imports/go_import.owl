AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0036157> "GO:0036157")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0036157> "outer dynein arm")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0036157> <http://purl.obolibrary.org/obo/GO_0005858>)


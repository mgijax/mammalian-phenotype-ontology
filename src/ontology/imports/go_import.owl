AnnotationAssertion(Annotation(rdfs:label "CREB1 phosphorylation through NMDA receptor-mediated activation of RAS signaling") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0007268> "Reactome:R-HSA-442742")
AnnotationAssertion(Annotation(rdfs:label "Activation of Na-permeable kainate receptors") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0007268> "Reactome:R-HSA-451307")
AnnotationAssertion(Annotation(rdfs:label "Activation of Ca-permeable Kainate Receptor") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0007268> "Reactome:R-HSA-451308")

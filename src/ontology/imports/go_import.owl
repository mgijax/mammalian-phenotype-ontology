AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0050901> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0050901> "GO:0050901")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0050901> "leukocyte tethering or rolling")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0050901> <http://purl.obolibrary.org/obo/GO_0061756>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0050901> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0045123>))


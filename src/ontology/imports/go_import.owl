AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0015030> "Gemini of coiled bodies")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0015030> "Gems")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0015030> "GO:0015030")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0015030> "Cajal body")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0015030> <http://purl.obolibrary.org/obo/GO_0140168>)


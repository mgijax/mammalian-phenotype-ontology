AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021549> "cerebellum development")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0021549> <http://purl.obolibrary.org/obo/GO_0160108>)

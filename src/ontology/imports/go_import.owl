AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0090596> "sensory organ morphogenesis")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0090596> <http://purl.obolibrary.org/obo/GO_0009887>)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0097225> "GO:0097225")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0097225> "sperm midpiece")

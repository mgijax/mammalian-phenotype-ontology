AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0060285> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0060285> "ciliary cell motility")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0060285> "GO:0060285")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0060285> "Note that we deem eukaryotic cilia and microtubule-based flagella to be equivalent.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0060285> "cilium-dependent cell motility")

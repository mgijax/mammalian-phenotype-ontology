AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cilia") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0824072820") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10381817") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21586547") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25361759") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0001520> "A supramolecular fiber found in the flagella of mammalian sperm that surrounds the nine microtubule doublets. These dense fibers are stiff and noncontractile. In human, they consist of about 10 major and at least 15 minor proteins, where all major proteins are ODF1, ODF2 or ODF2-related proteins.")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0031049> <http://purl.obolibrary.org/obo/go#goslim_pir>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0031049> "programmed DNA elimination")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0031049> <http://purl.obolibrary.org/obo/GO_0010629>)

# Class: <http://purl.obolibrary.org/obo/GO_0031052> (programmed DNA elimination by chromosome breakage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:ns") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15956677") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25303953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32165395") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0031052> "Regulated cleavage of the developing macronuclear genome at a limited number of chromosome breakage sites (CBS). The macronuclear destined segment (MDS) sequence adjacent to the CBS (or separated from it by a BES) receives a macronuclear telomere following chromosome breakage.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/GO_0031052> "https://github.com/geneontology/go-ontology/issues/22815"^^xsd:anyURI)

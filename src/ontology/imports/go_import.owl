AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0781735149") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14680625") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14708592") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7507411") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8600538") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0050904> "The passage of a leukocyte between the tight junctions of endothelial cells lining blood vessels, typically the fourth and final step of cellular extravasation.")

# Class: <http://purl.obolibrary.org/obo/GO_0006284> (base-excision repair)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0815316194") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0006284> "In base excision repair, an altered base is removed by a DNA glycosylase enzyme, followed by excision of the resulting sugar phosphate. The small gap left in the DNA helix is filled in by the sequential action of DNA polymerase and DNA ligase.")
AnnotationAssertion(Annotation(rdfs:label "Base Excision Repair") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006284> "Reactome:R-HSA-73884")
AnnotationAssertion(Annotation(rdfs:label "Abasic sugar-phosphate removal via the single-nucleotide replacement pathway") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006284> "Reactome:R-HSA-73930")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006284> "Wikipedia:Base_excision_repair")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0006284> "BER")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0006284> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0006284> "GO:0006284")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006284> "base-excision repair")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0006284> <http://purl.obolibrary.org/obo/GO_0006281>)

# Class: <http://purl.obolibrary.org/obo/GO_0006298> (mismatch repair)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0198506732") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11687886") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0006298> "A system for the correction of errors in which an incorrect base, which cannot form hydrogen bonds with the corresponding base in the parent strand, is incorporated into the daughter strand. The mismatch repair system promotes genomic fidelity by repairing base-base mismatches, insertion-deletion loops and heterologies generated during DNA replication and recombination.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0006298> "GO:0006300")
AnnotationAssertion(Annotation(rdfs:label "Mismatch Repair") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006298> "Reactome:R-HSA-5358508")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006298> "Wikipedia:DNA_mismatch_repair")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0006298> "MMR")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_0006298> "long patch mismatch repair system")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0006298> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0006298> "MutS/MutL/MutH pathway")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0006298> "mismatch repair, MutL-like pathway")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0006298> "GO:0006298")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006298> "mismatch repair")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0006298> <http://purl.obolibrary.org/obo/GO_0006281>)

# Class: <http://purl.obolibrary.org/obo/GO_0006302> (double-strand break repair)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:elh") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0006302> "The repair of double-strand breaks in DNA via homologous and nonhomologous mechanisms to reform a continuous DNA helix.")
AnnotationAssertion(Annotation(rdfs:label "DNA Double-Strand Break Repair") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006302> "Reactome:R-HSA-5693532")

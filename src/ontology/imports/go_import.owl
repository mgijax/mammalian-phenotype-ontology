AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0071753> "Note that an IgM immunoglobulin complex has the function of antigen binding if a suitable antigen is available.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0071753> "IgM immunoglobulin complex")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0071753> <http://purl.obolibrary.org/obo/GO_0019814>)


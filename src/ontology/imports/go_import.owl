AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0030098> "Note that immunologists typically use the word 'development' to refer to cells of B or T cell lineages undergoing the process that GO describes as 'cell differentiation'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0030098> "lymphocyte differentiation")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0030098> <http://purl.obolibrary.org/obo/GO_0046649>)

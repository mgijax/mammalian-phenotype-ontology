AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CL:0000899") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:BHF") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:ebc") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0072539> "The process in which a relatively unspecialized T cell acquires the specialized features of a T-helper 17 (Th17) cell. A Th17 cell is a CD4-positive, alpha-beta T cell with the phenotype RORgamma-t-positive that produces IL-17.")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0007340> "GO:0007340")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0007340> "If the release of the acrosome content occurs before the sperm reaches the zona pellucida, consider using premature acrosome loss.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0007340> "acrosome reaction")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0007340> <http://purl.obolibrary.org/obo/GO_0022414>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0007340> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0007338>))

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0036156> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0036156> "GO:0036156")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0036156> "inner dynein arm")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0036156> <http://purl.obolibrary.org/obo/GO_0005858>)

# Class: <http://purl.obolibrary.org/obo/GO_0036157> (outer dynein arm)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:BHF") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:vk") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2557057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:6218174") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0036157> "Outer arm structure present on the outer doublet microtubules of ciliary and flagellar axonemes. Outer dynein arms contain 2-3 heavy chains, two or more intermediate chains and a cluster of 4-8 light chains. Inner and outer dynein arms have different functions in the generation of microtubule-based motility.")

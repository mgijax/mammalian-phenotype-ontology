AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cilia") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10330409") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22118931") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0097728> "A motile cilium where the axoneme has a ring of nine outer microtubule doublets but no central microtubules (and is therefore called a 9+0 axoneme).")
